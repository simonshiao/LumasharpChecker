<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <InspRuntimeDir Condition="'$(InspRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\App\NativeR3</InspRuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="InspTools"><HintPath>$(InspRuntimeDir)\InspTools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OpenCvSharp"><HintPath>$(InspRuntimeDir)\OpenCvSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CopyNativeHostDependencies" AfterTargets="Build">
    <ItemGroup>
      <_HostDll Include="$(InspRuntimeDir)\*.dll" Exclude="$(InspRuntimeDir)\*cuda*.dll;$(InspRuntimeDir)\*tensorrt*.dll;$(InspRuntimeDir)\TRT.dll;$(InspRuntimeDir)\DeltaAIProcessDll.dll;$(InspRuntimeDir)\libtensorflow.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_HostDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>




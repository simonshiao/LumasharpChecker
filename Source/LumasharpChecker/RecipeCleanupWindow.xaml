<Window x:Class="LumasharpChecker.RecipeCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配方進階維護 · 清理與還原" Width="850" Height="640"
        MinWidth="720" MinHeight="510" WindowStartupLocation="CenterOwner"
        Background="#F5F7FA" Foreground="#27313F"
        FontFamily="Microsoft JhengHei UI" FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="清理配方" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="勾選要移出清單的配方；確認並輸入指定文字後才會執行。"
                       Foreground="#657185" Margin="0,5,0,0"/>
            <TextBlock Text="外部圖庫、原廠母本和共用 Profile 不會被清除。保留區中的配方可直接還原。"
                       Foreground="#657185" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E4E9F1" BorderThickness="1" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="目前配方" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Name="SelectedCountText" Text="已選取 0 筆" Margin="0,5,0,0" Foreground="#657185" FontSize="12"/>
                    </StackPanel>
                    <ListBox x:Name="ActiveRecipeList" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="2,8" Click="ActiveRecipe_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Details}" Foreground="#6A7482" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#E4E9F1" BorderThickness="1" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="可復原保留區" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="選取右側項目後按「還原」" Foreground="#657185" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="ArchivedRecipeList" BorderBrush="#E4E9F1" Background="#FCFDFE"
                             DisplayMemberPath="Display" SelectionChanged="ArchivedRecipe_SelectionChanged"/>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Text="尚未執行任何變更。" Foreground="#687589"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button x:Name="RestoreButton" Grid.Column="1" Content="還原選取" Width="104"
                    Padding="12,9" Margin="0,0,10,0" Click="Restore_Click" IsEnabled="False"/>
            <Button x:Name="CleanupButton" Grid.Column="2" Content="清理選取…" Width="118"
                    Padding="12,9" Background="#E7F2FF" Foreground="#0367CB"
                    BorderBrush="#C6DFF8" Margin="0,0,10,0" IsEnabled="False" Click="Cleanup_Click"/>
            <Button Grid.Column="3" Content="完成" Width="85" Padding="12,9" Click="Done_Click"/>
        </Grid>
    </Grid>
</Window>

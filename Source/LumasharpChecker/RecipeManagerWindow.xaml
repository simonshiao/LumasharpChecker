<Window x:Class="LumasharpChecker.RecipeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配方管理" Width="940" Height="590"
        MinWidth="800" MinHeight="500" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft JhengHei UI" FontSize="13"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">
    <Window.Resources>
        <Style x:Key="RecipeSidebarAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="配方管理" Style="{DynamicResource HudSectionTitle}"/>
            <TextBlock Text="按「自動匯入」選取外觀機配方；其他來源請使用「其他匯入」。" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            <TextBlock Text="各配方保存自己的站別參數；載入後從主畫面右側工具調整。" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F7FAFC" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="站數" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding StationCountOptions}"
                                      SelectedItem="{Binding StationCount, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource RecipeSidebarAction}"
                                Command="{Binding CreateRecipeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                                <TextBlock Text="新增"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RecipeSidebarAction}"
                                Command="{Binding LoadSelectedRecipeCommand}"
                                IsEnabled="{Binding HasSelectedRecipe}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                                <TextBlock Text="載入"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RecipeSidebarAction}"
                                Command="{Binding ImportDefaultVendorRecipeSnapshotCommand}"
                                ToolTip="從外觀機預設路徑匯入配方">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                                <TextBlock Text="自動匯入"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RecipeSidebarAction}"
                                Command="{Binding ImportVendorRecipeSnapshotCommand}"
                                ToolTip="選取原廠資料夾，批次比對並匯入或更新配方">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                                <TextBlock Text="其他匯入"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="4,10"/>
                        <Button Style="{StaticResource RecipeSidebarAction}"
                                Command="{Binding DeleteRecipeCommand}" IsEnabled="{Binding HasSelectedRecipe}"
                                Foreground="{StaticResource Red}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                                <TextBlock Text="刪除"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="配方" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                             BorderBrush="{StaticResource Line}" Background="{StaticResource SurfaceSubtle}"
                             Padding="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="MouseDoubleClick" Handler="RecipeItem_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StationCount, StringFormat={}{0} 站}"
                                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="完成" MinWidth="100"
                    Style="{DynamicResource HudPrimaryButton}" Click="Done_Click"/>
        </DockPanel>
    </Grid>
</Window>

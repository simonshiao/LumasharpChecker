<Window x:Class="LumasharpChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:LumasharpChecker.viewmodel"
        xmlns:local="clr-namespace:LumasharpChecker"
        xmlns:view="clr-namespace:LumasharpChecker.view"
        mc:Ignorable="d"
        Title="LumasharpChecker" Height="880" Width="1120" WindowState="Maximized"
        MinHeight="720" MinWidth="1050"
        FontFamily="Microsoft JhengHei UI"
        FontSize="13"
        Foreground="{DynamicResource Text}"
        Background="{DynamicResource Bg}">

    <Window.Resources>
        <Style x:Key="NavigationRailButton" TargetType="Button">
            <Setter Property="Foreground" Value="#535C70"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RailTile" Background="Transparent" CornerRadius="14" Padding="4,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RailTile" Property="Background" Value="#E9ECF3"/></Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="RailTile" Property="Background" Value="#DCE5FA"/>
                                <Setter Property="Foreground" Value="#244C99"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RailTile" Property="BorderBrush" Value="#4368AC"/><Setter TargetName="RailTile" Property="BorderThickness" Value="1"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="RailTile" Property="Background" Value="#C7D6F4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <vm:PathToImageConverter x:Key="ImageConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Shared LUMA HUD palette — aligns single-station and overview pages. -->
        <SolidColorBrush x:Key="Bg" Color="#F0F8FC"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSubtle" Color="#F4FAFD"/>
        <SolidColorBrush x:Key="Line" Color="#CBE4EF"/>
        <SolidColorBrush x:Key="Text" Color="#0B2942"/>
        <SolidColorBrush x:Key="Muted" Color="#527388"/>
        <SolidColorBrush x:Key="Blue" Color="#0078B8"/>
        <SolidColorBrush x:Key="BlueSoft" Color="#E4F7FE"/>
        <SolidColorBrush x:Key="Green" Color="#18B57B"/>
        <SolidColorBrush x:Key="Orange" Color="#F5A623"/>
        <SolidColorBrush x:Key="Red" Color="#E95765"/>
        <DropShadowEffect x:Key="CardShadow" Color="#226CA0" Direction="270" ShadowDepth="2" BlurRadius="14" Opacity="0.1"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="0,0,0,9"
                                                  RecognizesAccessKey="True"
                                                  TextElement.FontSize="15"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource Text}"/>
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="Content"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputChrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#79DDF7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Blue}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource BlueSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource BlueSoft}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ReadOnlyValue" TargetType="TextBlock">
            <Setter Property="Background" Value="#F4F7F9"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ResultValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Chao8Side-style command strip. All actions remain real WPF commands. -->
        <Style x:Key="TopIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource HudBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TopIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
        </Style>
        <Style x:Key="YieldCardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chao8Side RecoveredBrightTheme light-blue machine HUD tokens;
             only the visual palette is reused, not RTX/PLC dependencies. -->
        <SolidColorBrush x:Key="HudText" Color="#0B2942"/>
        <SolidColorBrush x:Key="HudTextSoft" Color="#45697E"/>
        <SolidColorBrush x:Key="HudAccent" Color="#18C7F4"/>
        <SolidColorBrush x:Key="HudAccentStrong" Color="#0078B8"/>
        <SolidColorBrush x:Key="HudBorder" Color="#79DDF7"/>
        <SolidColorBrush x:Key="HudOk" Color="#18C985"/>
        <SolidColorBrush x:Key="HudNg" Color="#FF5F6D"/>
        <LinearGradientBrush x:Key="HudPageGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F7FCFF"/>
            <GradientStop Offset="1" Color="#E6F6FF"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HudHeaderGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#FFFFFF"/>
            <GradientStop Offset="1" Color="#DDF5FF"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HudCameraGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#071828"/>
            <GradientStop Offset="1" Color="#0A354A"/>
        </LinearGradientBrush>
        <Style x:Key="HudStationCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{StaticResource HudBorder}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HudChrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HudChrome" Property="BorderBrush" Value="{StaticResource HudAccentStrong}"/>
                                <Setter TargetName="HudChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HudChrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HudChrome" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource HudAccentStrong}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="182"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 舊單站檢測僅保留內部邏輯，使用者統一從 AOI 工具進入站別工作區。 -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Grid.Row="1"
                Background="#F2F3F8" BorderBrush="#E1E5ED"
                BorderThickness="0,0,1,0" Padding="8,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="3,0,3,21">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="SidebarBrand">
                            <TextBlock Text="功能導覽" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <TextBlock Text="工作區" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="SidebarToggle" Grid.Column="1" Click="ToggleSidebar_Click"
                                Content="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                ToolTip="收合／展開導覽列" AutomationProperties.Name="切換側欄"
                                Width="32" Height="32" MinHeight="0" Padding="0"/>
                    </Grid>
                    <TextBlock x:Name="SidebarSectionLabel" Text="檢測工作區"
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,8"/>
                    <Button Style="{StaticResource NavigationRailButton}" x:Name="OverviewNavButton" Click="ShowOverview_Click"
                            ToolTip="總覽" AutomationProperties.Name="總覽"
                            Background="{StaticResource BlueSoft}" BorderBrush="{StaticResource Blue}"
                            Padding="4,7" Margin="0,0,0,6" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="OverviewNavLabel" Text="總覽" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationRailButton}" x:Name="AoiToolsNavButton" Click="ShowAoiTools_Click"
                            ToolTip="工具" AutomationProperties.Name="工具"
                            Padding="4,7" Margin="0,0,0,6" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="AoiToolsNavLabel" Text="工具" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="8,12,4,4">
                    <TextBlock Text="獨立精簡版" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 上方左半部全為操作圖示，右半部顯示配方／站別／檢測狀態。 -->
        <Border x:Name="MainHeaderBar" Grid.Row="0" Grid.ColumnSpan="2"
                Panel.ZIndex="18" Background="{StaticResource HudHeaderGradient}"
                BorderBrush="{StaticResource HudBorder}" BorderThickness="0,0,0,1"
                Padding="10,6,17,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopIconButton}"
                            Click="OpenRecipeManager_Click"
                            AutomationProperties.Name="上方選擇配方"
                            ToolTip="選擇／管理配方">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/>
                            <TextBlock Text="配方" FontFamily="Microsoft JhengHei UI" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="30" Background="{StaticResource HudBorder}"
                            Margin="6,0"/>
                    <Button Style="{StaticResource TopIconButton}"
                            Click="OpenDatabaseSetup_Click"
                            IsEnabled="{Binding IsRecipeActive}"
                            AutomationProperties.Name="上方各站圖庫"
                            ToolTip="各站 OK／NG 作業圖庫設定">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/>
                            <TextBlock Text="圖庫" FontFamily="Microsoft JhengHei UI" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopIconButton}"
                            Command="{Binding ExportTestImagesCommand}"
                            AutomationProperties.Name="匯出報表"
                            ToolTip="匯出目前 Recipe 所有已完成站別的 Excel 檢測報表；未測站別不建立工作表">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/>
                            <TextBlock Text="報表" FontFamily="Microsoft JhengHei UI" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopIconButton}"
                            Command="{Binding ShowTestImageResultsCommand}"
                            AutomationProperties.Name="檢視全部站別結果"
                            ToolTip="查看目前配方全部站別的檢測結果，清單會標示站別">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/>
                            <TextBlock Text="結果" FontFamily="Microsoft JhengHei UI" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
                <Border Grid.Column="2" Width="235" Background="#E8F8FE" CornerRadius="8"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Padding="12,5" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="目前配方" FontSize="10"
                                   Foreground="{StaticResource HudTextSoft}"/>
                        <TextBlock Text="{Binding CurrentRecipe.Name, TargetNullValue=尚未載入配方}"
                                   FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"
                                   Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentRecipe.Name}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,15,0"
                            MinWidth="100">
                    <TextBlock Text="站別" FontSize="10" Foreground="{StaticResource HudTextSoft}"/>
                    <TextBlock Text="{Binding CurrentStationStatusText}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HudText}"
                               Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding RecipeConfigurationSummary}" FontSize="10"
                               Foreground="{StaticResource HudAccentStrong}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Width="159">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding GlobalStatusBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="檢測狀態" Foreground="{StaticResource HudTextSoft}"
                                   FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="{Binding GlobalRunStatusText}"
                               Foreground="{StaticResource HudText}" FontSize="11"
                               FontWeight="SemiBold" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding GlobalRunStatusText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="InspectionPage" Grid.Column="1" Grid.Row="1" Margin="15,7,15,12"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectionSideColumn" Width="322"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#20252D"
                        BorderBrush="#D7DEE8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        PreviewMouseWheel="MainImage_PreviewMouseWheel">
                    <Grid ClipToBounds="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#8D9BAD" HorizontalAlignment="Center"/>
                        <TextBlock Text="尚無影像" Foreground="#E4E9F1" FontSize="17" Margin="0,18,0,8" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Viewbox Stretch="Uniform">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers><DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Grid>
                            <Image Source="{Binding DisplayImage}" Stretch="None" IsHitTestVisible="False"/>
                            <Canvas x:Name="MainRoiCanvas"
                                    Width="{Binding DisplayImage.PixelWidth}"
                                    Height="{Binding DisplayImage.PixelHeight}"
                                    IsHitTestVisible="False">
                                    <Rectangle Stroke="#FF43A047"
                                               StrokeThickness="{Binding StrokeThickness}"
                                               Width="{Binding DisplayRectWidth}"
                                               Height="{Binding DisplayRectHeight}"
                                               Canvas.Left="{Binding DisplayRectX}"
                                               Canvas.Top="{Binding DisplayRectY}"
                                               Visibility="{Binding IsGreenBoxVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               IsHitTestVisible="False"/>
                                    <Rectangle Visibility="{Binding IsBrightnessBoxVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Stroke="#FF039BE5"
                                               StrokeThickness="{Binding StrokeThickness2}"
                                               Width="{Binding DisplayRectWidth2}"
                                               Height="{Binding DisplayRectHeight2}"
                                               Canvas.Left="{Binding DisplayRectX2}"
                                               Canvas.Top="{Binding DisplayRectY2}"
                                               IsHitTestVisible="False"/>

                            </Canvas>
                        </Grid>
                    </Viewbox>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Margin="0,7,0,0" Padding="9,6"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="2,0,2,6">
                            <TextBlock Text="站" FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}" Margin="2,2,0,0"/>
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StationSlots}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0">
                                        <Button Content="{Binding Number}" Width="58" Padding="0" MinWidth="0" MinHeight="32"
                                                Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Number}"
                                                IsEnabled="{Binding DataContext.IsRecipeActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="切換站別">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Margin="0,6,0,0" Padding="7,4"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="OpenDatabaseSetup_Click" IsEnabled="{Binding IsRecipeActive}"
                                    Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    ToolTip="開啟作業圖庫設定" AutomationProperties.Name="作業圖庫設定">
                                <Grid Width="23" Height="21">
                                    <Path Data="M2,5 L9,5 L11,8 L22,8 L22,19 L2,19 Z"
                                          Width="18" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Stretch="Fill" Fill="#F0E6FA" Stroke="#8A3AB9" StrokeThickness="1.5"/>
                                    <Border Width="13" Height="13" Background="{StaticResource Surface}" CornerRadius="7"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="#8A3AB9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Command="{Binding TestImageCommand}"
                                    Visibility="Collapsed"
                                    Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    ToolTip="選擇資料夾；只建立圖片清單，不會立即測試"
                                    AutomationProperties.Name="選擇資料夾">
                                <Path Data="M2,5 L9,5 L11,8 L22,8 L22,19 L2,19 Z"
                                      Width="18" Height="14" Stretch="Fill"
                                      Fill="{StaticResource BlueSoft}" Stroke="{StaticResource Blue}" StrokeThickness="1.5"/>
                            </Button>
                            <Button Command="{Binding SelectSingleImageCommand}"
                                    Visibility="Collapsed"
                                    Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    ToolTip="選擇單張圖片；只顯示圖片，不會立即測試"
                                    AutomationProperties.Name="選擇單張圖片">
                                <Viewbox Width="18" Height="16">
                                    <Grid Width="24" Height="20">
                                        <Border BorderBrush="{StaticResource Blue}" BorderThickness="1.7" CornerRadius="2"/>
                                        <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource Blue}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,3,0,0"/>
                                        <Path Data="M3,17 L9,10 L13,14 L17,8 L22,17 Z" Fill="#B9D8FF" Stroke="{StaticResource Blue}" StrokeThickness="1.2"/>
                                    </Grid>
                                </Viewbox>
                            </Button>
                            <Button Command="{Binding OpenStationDatabaseCommand}" CommandParameter="OK" Content="OK DB"
                                    IsEnabled="{Binding IsRecipeActive}" Height="34" MinHeight="0" Padding="7,0" Margin="2"
                                    Foreground="#248A3D" ToolTip="載入目前站別的 OK 圖庫"/>
                            <Button Command="{Binding OpenStationDatabaseCommand}" CommandParameter="NG" Content="NG DB"
                                    IsEnabled="{Binding IsRecipeActive}" Height="34" MinHeight="0" Padding="7,0" Margin="2"
                                    Foreground="#D32F2F" ToolTip="載入目前站別的 NG 圖庫"/>
                            <Button Command="{Binding OpenStationDatabaseCommand}" CommandParameter="ALL" Content="ALL DB"
                                    IsEnabled="{Binding IsRecipeActive}" Height="34" MinHeight="0" Padding="7,0" Margin="2"
                                    ToolTip="合併目前站別 OK DB 與 NG DB；統計會同時顯示圖庫標記與檢測判定"/>
                            <Button Command="{Binding OpenStandardPartImageCommand}" Content="標準件圖"
                                    IsEnabled="{Binding IsRecipeActive}" Height="34" MinHeight="0" Padding="7,0" Margin="2"
                                    ToolTip="左鍵：載入本站標準件圖；右鍵選單：直接以目前圖片設為標準件">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="StandardPartMenu_Opened">
                                        <MenuItem Header="設為標準件" Click="ConfigureStandardPart_Click"
                                                  ToolTipService.ShowOnDisabled="True"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,20,0">
                        <Button Click="OpenTestImagePicker_Click"
                                Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                ToolTip="開啟圖片清單，只切換預覽"
                                AutomationProperties.Name="圖片清單"/>
                        <Button Command="{Binding PreviousTestImageCommand}"
                                Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                IsEnabled="{Binding CanNavigatePrevious}" ToolTip="上一張圖片"/>
                        <TextBlock Text="{Binding TestImageInfo}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="78" TextAlignment="Center" Margin="5,0"/>
                        <Button Command="{Binding NextTestImageCommand}"
                                Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                IsEnabled="{Binding CanNavigateNext}" ToolTip="下一張圖片"/>
                        <Button Click="StartFlowContinuous_Click"
                                FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="38" Height="34" MinHeight="0" Padding="0" Margin="8,2,2,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="&#xE768;"/>
                                    <Setter Property="ToolTip" Value="開始連續測試目前清單中的圖片"/>
                                    <Setter Property="AutomationProperties.Name" Value="開始連續測試"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContinuousTestRunning}" Value="True">
                                            <Setter Property="Content" Value="&#xE769;"/>
                                            <Setter Property="ToolTip" Value="停止本輪連續測試；再次開始會重新計數"/>
                                            <Setter Property="AutomationProperties.Name" Value="停止連續測試"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding FilterTestImageFilesByStatusCommand}" CommandParameter="ALL"
                                    Content="ALL" Width="46" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    ToolTip="主畫面清單顯示全部已判定圖片" AutomationProperties.Name="篩選全部圖片"/>
                            <Button Command="{Binding FilterTestImageFilesByStatusCommand}" CommandParameter="OK"
                                    Content="OK" Width="42" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    Foreground="#248A3D" ToolTip="主畫面清單只顯示已判定 OK 的圖片" AutomationProperties.Name="篩選 OK 圖片"/>
                            <Button Command="{Binding FilterTestImageFilesByStatusCommand}" CommandParameter="NG"
                                    Content="NG" Width="42" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    Foreground="#D32F2F" ToolTip="主畫面清單只顯示已判定 NG 的圖片" AutomationProperties.Name="篩選 NG 圖片"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <view:AoiWorkflowPanel x:Name="AoiWorkflow" Grid.Row="0" Grid.Column="1"
                                   Visibility="Collapsed"/>
            <Button x:Name="AoiPanelReopen" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top"
                    Visibility="Collapsed" Content="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                    Click="OpenAoiPanel_Click" Width="40" Height="40" Padding="0" MinWidth="0"
                    ToolTip="展開 AOI 工具" AutomationProperties.Name="展開 AOI 工具"/>

            <!-- Compact left-side telemetry card; keep AOI controls in their own column. -->
            <Border Grid.Row="1" Grid.Column="0" Margin="0,8,10,0"
                    MinHeight="74" VerticalAlignment="Top"
                    Background="#EAF3F8" BorderBrush="#C7DCE7" BorderThickness="1"
                    CornerRadius="9" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource YieldCardButtonStyle}"
                                Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ShowTestImageResultsByStatusCommand}"
                                CommandParameter="OK" ToolTip="檢視 OK 結果"
                                AutomationProperties.Name="檢視 OK 結果">
                            <DockPanel Margin="9,2,12,2">
                                <TextBlock Text="OK" Foreground="#208563" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding OverallOkCount}" Foreground="#24445A"
                                               FontFamily="Consolas" FontSize="18"
                                               TextAlignment="Right" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Border Grid.Column="1" Background="#CEDFE8" Margin="0,8"/>
                        <Button Grid.Column="2" Style="{StaticResource YieldCardButtonStyle}"
                                Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ShowTestImageResultsByStatusCommand}"
                                CommandParameter="NG" ToolTip="檢視 NG 結果（包含 Retest）"
                                AutomationProperties.Name="檢視 NG 結果">
                            <DockPanel Margin="12,2">
                                <TextBlock Text="NG" Foreground="#B85560" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding OverallNgCount}" Foreground="#24445A"
                                               FontFamily="Consolas" FontSize="18"
                                               TextAlignment="Right" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Border Grid.Column="3" Background="#CEDFE8" Margin="0,8"/>
                        <Button Grid.Column="4" Style="{StaticResource YieldCardButtonStyle}"
                                Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ShowTestImageResultsByStatusCommand}"
                                CommandParameter="Retest" ToolTip="Retest 是 NG 總數的子集"
                                AutomationProperties.Name="檢視 Retest 結果">
                            <DockPanel Margin="10,2">
                                <TextBlock Text="Retest" Foreground="#BD7425" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding OverallRetestCount}" Foreground="#24445A"
                                               FontFamily="Consolas" FontSize="18"
                                               TextAlignment="Right" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Border Grid.Column="5" Background="#CEDFE8" Margin="0,8"/>
                        <StackPanel Grid.Column="6" Margin="10,3,8,3" VerticalAlignment="Center">
                            <TextBlock Text="本輪已判定" Foreground="#637F91" FontSize="11" ToolTip="只累計本輪連續測試；上下張與單張重測不改變統計"/>
                            <TextBlock Text="{Binding TotalTestImageCount, StringFormat={}{0:N0}}"
                                       Foreground="#24445A" FontFamily="Consolas"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OverallOkRateText, StringFormat=良率 {0}}"
                                       Foreground="#637F91" FontSize="11"/>
                        </StackPanel>
                        <Border Grid.Column="7" Background="#CEDFE8" Margin="0,8"/>
                        <StackPanel Grid.Column="8" Margin="10,3,0,3" VerticalAlignment="Center">
                            <TextBlock Text="亮度" Foreground="#637F91" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TestImageBrightness, StringFormat={}{0:F2}}"
                                           Foreground="#24445A" FontFamily="Consolas"
                                           FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TestImageBrightnessDeltaPercentText}"
                                           Foreground="#54839D" FontFamily="Consolas"
                                           FontSize="11" Margin="10,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="9,9,9,0"
                          Visibility="{Binding IsAnalyzingTestImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AnalysisProgressText}" Foreground="#637F91"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ProgressBar Grid.Column="1" Minimum="0"
                                     Maximum="{Binding AnalysisProgressMaximum}"
                                     Value="{Binding AnalysisProgressValue}" Height="4"
                                     Foreground="#55A8C8" Background="#D0E2EA"
                                     BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <!-- AOI status and messages belong under the right-side tools, not inside the tool grid. -->
            <Border Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                    Background="#F1F7FA" BorderBrush="#CBDDE7" BorderThickness="1"
                    CornerRadius="9" Padding="11,8">
                <Grid Height="155">
                    <TextBox x:Name="AoiMessageLog" IsReadOnly="True"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             MinHeight="145" MinWidth="0"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Background="#FCFEFF" Foreground="#355C72" BorderBrush="#D5E4EC"
                             BorderThickness="1" Padding="6,4" FontSize="11"
                             FontFamily="Consolas" AutomationProperties.Name="可複製的 AOI 檢測訊息"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 八／十站共覽：使用同一 Recipe／站別狀態，不另建第二份資料。 -->
        <Grid x:Name="StationOverviewPage" Grid.Column="1" Grid.Row="1" 
              Background="{StaticResource HudPageGradient}" TextElement.FontFamily="Segoe UI">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <!-- 首頁不是設定頁：只留配方、實測統計與開始／停止鍵。 -->
            <Border Margin="23,17,23,13" CornerRadius="11" Padding="15,10"
                    Background="{StaticResource HudHeaderGradient}"
                    BorderBrush="{StaticResource HudBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="108" Height="34" Margin="0,0,8,0"
                                  VerticalContentAlignment="Center"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding MultiStationDatabaseSelection, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanChangeMultiStationDatabaseSelection}"
                                  AutomationProperties.Name="完整多站測試圖庫"
                                  ToolTip="只影響完整圖庫測試；最新指定張數測試使用齒輪內各站來源設定。">
                            <ComboBoxItem Content="ALL DB" Tag="ALL"/>
                            <ComboBoxItem Content="OK DB" Tag="OK"/>
                            <ComboBoxItem Content="NG DB" Tag="NG"/>
                        </ComboBox>
                        <Button Command="{Binding RunMultiStationInspectionCommand}"
                                IsEnabled="{Binding IsRecipeActive}"
                                Content="▶  連續測試"
                                AutomationProperties.Name="連續測試勾選站別"
                                ToolTip="依圖庫選項逐站連續測試勾選站別的全部圖片；未校準站跳過。"
                                Background="#D2F5FF" BorderBrush="{StaticResource HudAccentStrong}"
                                Foreground="{StaticResource HudAccentStrong}"
                                FontWeight="SemiBold" Padding="16,7" Margin="0,0,7,0"/>
                        <Button Command="{Binding RunMultiStationRecentImagesCommand}"
                                IsEnabled="{Binding IsRecipeActive}"
                                Content="單顆點檢"
                                AutomationProperties.Name="點檢勾選站別的最新圖片"
                                ToolTip="只點檢目前勾選的站別，並依齒輪設定的各站圖庫來源與張數選取最新圖片；選用的 OK／NG 圖庫沒有圖片時會改用 ALL DB。各站來源與張數可在齒輪設定。"
                                Background="{StaticResource Surface}" BorderBrush="{StaticResource HudBorder}"
                                Foreground="{StaticResource HudAccentStrong}"
                                FontWeight="SemiBold" Padding="12,7" Margin="0,0,7,0"/>
                        <Button Command="{Binding StopMultiStationInspectionCommand}"
                                IsEnabled="{Binding IsMultiStationTesting}" Content="停止"
                                AutomationProperties.Name="停止多站測試" Padding="11,7"
                                BorderBrush="{StaticResource HudNg}" Foreground="#B53048"/>
                        <ToggleButton x:Name="MultiStationSettingsButton"
                                      Style="{StaticResource TopIconToggle}"
                                      Width="38" Height="34" MinHeight="0" Padding="0" Margin="7,0,0,0"
                                      Content="&#xE713;" ToolTip="設定各站最新測試張數"
                                      IsEnabled="{Binding IsRecipeActive}"
                                      AutomationProperties.Name="多站測試設定"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource HudAccent}" Width="4"
                                CornerRadius="2" Margin="0,2,13,2"/>
                        <TextBlock Text="總覽"
                                   FontWeight="Bold" FontSize="17" VerticalAlignment="Center"
                                   Foreground="{StaticResource HudText}" Margin="0,0,19,0"/>
                        <TextBlock Text="{Binding MultiStationTotal}" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudAccentStrong}"/>
                    </StackPanel>
                </DockPanel>
                <Popup x:Name="MultiStationSettingsPopup"
                       IsOpen="{Binding IsChecked, ElementName=MultiStationSettingsButton, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=MultiStationSettingsButton}"
                       Placement="Bottom" HorizontalOffset="-340" VerticalOffset="7"
                       StaysOpen="False" AllowsTransparency="True"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <Border Width="350" Padding="15" CornerRadius="10"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="各站最新圖片設定" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" Margin="0,0,0,5"/>
                            <TextBlock Text="全站共用 OK／NG／ALL 來源，各站張數可個別調整（1–500 張）。分類沒有圖片時自動改用全部。"
                                       FontSize="11" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="全站圖片來源" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox Width="100" Height="30" HorizontalAlignment="Right" SelectedValuePath="Tag"
                                          SelectedValue="{Binding GlobalRecentImageSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="全站圖片來源" ToolTip="選取後立即套用全站並保存至目前 Recipe。">
                                    <ComboBoxItem Content="OK" Tag="OK"/>
                                    <ComboBoxItem Content="NG" Tag="NG"/>
                                    <ComboBoxItem Content="全部" Tag="ALL"/>
                                </ComboBox>
                            </DockPanel>
                            <Border Background="{StaticResource SurfaceSubtle}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="7" Padding="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="同時調整全站張數" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="套用後覆蓋下方各站張數"
                                                   FontSize="10" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="54" Height="30" Padding="4,3" TextAlignment="Center"
                                                 Text="{Binding GlobalRecentImageCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.Name="全站最新測試張數"/>
                                        <Button Command="{Binding ApplyGlobalRecentImageCountCommand}"
                                                Content="套用" Padding="8,4" Margin="6,0,0,0"
                                                AutomationProperties.Name="套用到全部站別張數"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding StationSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number, StringFormat=第 {0} 站}"
                                                           VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox Width="54" Height="30" Padding="4,3"
                                                             TextAlignment="Center"
                                                             Text="{Binding RecentImageCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站最新測試張數}"/>
                                                    <TextBlock Text="張" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource Muted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="設定保存於目前 Recipe。全站張數可一鍵套用；未勾選的站別不執行。"
                                       FontSize="11" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <TextBlock Grid.Row="1" Text="{Binding MultiStationProgress}"
                           Foreground="{StaticResource HudTextSoft}" FontSize="11"
                           Margin="16,4,0,0" MaxHeight="16" TextTrimming="CharacterEllipsis"/>
            </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="17,0,17,15">
                <ItemsControl ItemsSource="{Binding StationSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5,6,11" Height="313">
                            <Button Style="{StaticResource HudStationCard}" Height="313"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    IsEnabled="{Binding DataContext.IsRecipeActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Number}"
                                    Click="OverviewStation_Click" AutomationProperties.Name="{Binding Number, StringFormat=開啟第 {0} 站檢測}"
                                    ToolTip="進入單站檢測；不會自動執行檢測">
                                <Grid Margin="11,10,11,11">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="4,1,4,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" CornerRadius="2" Background="{StaticResource HudAccent}"
                                                    Margin="0,1,9,1"/>
                                            <TextBlock Text="{Binding Number}" FontSize="20"
                                                       FontWeight="Bold" Foreground="{StaticResource HudText}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,0,27,0"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding BatchStatusBrush}"
                                                     Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding BatchStatus}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource HudTextSoft}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Chao8Side's dark camera viewport and thin cyan border. -->
                                    <Border Grid.Row="1" Background="{StaticResource HudCameraGradient}"
                                            CornerRadius="4" BorderBrush="#2A88AE"
                                            BorderThickness="1" Margin="0,0,0,9" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="4"/>
                                        </Grid>
                                    </Border>
                                    <!-- Single shared telemetry strip, no stacked pastel KPI cards. -->
                                    <Grid Grid.Row="2" Margin="0,2,0,7" Background="#0D2737">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="0.95*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="10,8" VerticalAlignment="Center">
                                            <TextBlock Text="OK" Foreground="#64D6AD" FontSize="10"/>
                                            <TextBlock Text="{Binding BatchOkText}" Foreground="#F0FAFE"
                                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="21"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#315062" Margin="0,9"/>
                                        <StackPanel Grid.Column="2" Margin="8,8" VerticalAlignment="Center"
                                                    ToolTip="NG 總數包含 Retest">
                                            <TextBlock Text="NG" Foreground="#FF8796" FontSize="10"/>
                                            <TextBlock Text="{Binding BatchNgText}" Foreground="#F0FAFE"
                                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="21"/>
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="#315062" Margin="0,9"/>
                                        <StackPanel Grid.Column="4" Margin="8,8" VerticalAlignment="Center">
                                            <TextBlock Text="Retest" Foreground="#F2B56E" FontSize="10"/>
                                            <TextBlock Text="{Binding BatchRetestText}" Foreground="#F0FAFE"
                                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="20"/>
                                        </StackPanel>
                                        <Border Grid.Column="5" Background="#315062" Margin="0,9"/>
                                        <StackPanel Grid.Column="6" Margin="8,8" VerticalAlignment="Center">
                                            <TextBlock Text="良率" Foreground="#8FB7C9" FontSize="10"/>
                                            <TextBlock Text="{Binding BatchYield}" Foreground="#58D7F4"
                                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="19"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Grid.Row="3" Height="3" Minimum="0" Maximum="100"
                                                 Value="{Binding BatchYieldValue, Mode=OneWay}"
                                                 Foreground="#18BFD7"
                                                 Background="#C5DDE5" BorderThickness="0" Margin="0"
                                                 IsHitTestVisible="False"/>
                                </Grid>
                            </Button>
                            <CheckBox IsChecked="{Binding IncludeInBatch, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,15,15,0" ToolTip="勾選後列入本次多站檢測"
                                      AutomationProperties.Name="{Binding Number, StringFormat=勾選第 {0} 站測試}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

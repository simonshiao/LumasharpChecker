<Window x:Class="LumasharpChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:LumasharpChecker.viewmodel"
        mc:Ignorable="d"
        Title="LumasharpChecker" Height="900" Width="1440"
        MinHeight="720" MinWidth="1130"
        FontFamily="Microsoft JhengHei UI"
        FontSize="13"
        Foreground="{DynamicResource Text}"
        Background="{DynamicResource Bg}">

    <Window.Resources>
        <vm:PathToImageConverter x:Key="ImageConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Shared LUMA HUD palette — aligns single-station and overview pages. -->
        <SolidColorBrush x:Key="Bg" Color="#F0F8FC"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSubtle" Color="#F4FAFD"/>
        <SolidColorBrush x:Key="Line" Color="#CBE4EF"/>
        <SolidColorBrush x:Key="Text" Color="#0B2942"/>
        <SolidColorBrush x:Key="Muted" Color="#527388"/>
        <SolidColorBrush x:Key="Blue" Color="#0078B8"/>
        <SolidColorBrush x:Key="BlueSoft" Color="#E4F7FE"/>
        <SolidColorBrush x:Key="Green" Color="#18B57B"/>
        <SolidColorBrush x:Key="Orange" Color="#F5A623"/>
        <SolidColorBrush x:Key="Red" Color="#E95765"/>
        <DropShadowEffect x:Key="CardShadow" Color="#226CA0" Direction="270" ShadowDepth="2" BlurRadius="14" Opacity="0.1"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="0,0,0,9"
                                                  RecognizesAccessKey="True"
                                                  TextElement.FontSize="15"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource Text}"/>
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="Content"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputChrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#79DDF7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Blue}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource BlueSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource BlueSoft}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ReadOnlyValue" TargetType="TextBlock">
            <Setter Property="Background" Value="#F4F7F9"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ResultValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Chao8Side-style command strip. All actions remain real WPF commands. -->
        <Style x:Key="TopIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource HudBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TopIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
        </Style>
        <Style x:Key="YieldCardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chao8Side RecoveredBrightTheme light-blue machine HUD tokens;
             only the visual palette is reused, not RTX/PLC dependencies. -->
        <SolidColorBrush x:Key="HudText" Color="#0B2942"/>
        <SolidColorBrush x:Key="HudTextSoft" Color="#45697E"/>
        <SolidColorBrush x:Key="HudAccent" Color="#18C7F4"/>
        <SolidColorBrush x:Key="HudAccentStrong" Color="#0078B8"/>
        <SolidColorBrush x:Key="HudBorder" Color="#79DDF7"/>
        <SolidColorBrush x:Key="HudOk" Color="#18C985"/>
        <SolidColorBrush x:Key="HudNg" Color="#FF5F6D"/>
        <LinearGradientBrush x:Key="HudPageGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F7FCFF"/>
            <GradientStop Offset="1" Color="#E6F6FF"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HudHeaderGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#FFFFFF"/>
            <GradientStop Offset="1" Color="#DDF5FF"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HudCameraGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#071828"/>
            <GradientStop Offset="1" Color="#0A354A"/>
        </LinearGradientBrush>
        <Style x:Key="HudStationCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{StaticResource HudBorder}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HudChrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HudChrome" Property="BorderBrush" Value="{StaticResource HudAccentStrong}"/>
                                <Setter TargetName="HudChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HudChrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HudChrome" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource HudAccentStrong}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="182"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 與 ChaoMcpHub 一致的輕量收合式導覽，保留原有單站檢測頁。 -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Grid.Row="1"
                Background="{StaticResource HudHeaderGradient}" BorderBrush="{StaticResource HudBorder}"
                BorderThickness="0,0,1,0" Padding="10,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="3,0,3,21">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="SidebarBrand">
                            <TextBlock Text="功能導覽" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <TextBlock Text="工作區" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="SidebarToggle" Grid.Column="1" Click="ToggleSidebar_Click"
                                Content="&#xE700;" FontFamily="Segoe MDL2 Assets"
                                ToolTip="收合／展開導覽列" AutomationProperties.Name="切換側欄"
                                Width="32" Height="32" MinHeight="0" Padding="0"/>
                    </Grid>
                    <TextBlock x:Name="SidebarSectionLabel" Text="檢測工作區"
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,8"/>
                    <Button x:Name="OverviewNavButton" Click="ShowOverview_Click"
                            ToolTip="八站總覽" AutomationProperties.Name="八站總覽"
                            Background="{StaticResource BlueSoft}" BorderBrush="{StaticResource Blue}"
                            Padding="10,10" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="24"/>
                            <TextBlock x:Name="OverviewNavLabel" Text="八站總覽" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="InspectionNavButton" Click="ShowInspection_Click"
                            ToolTip="單站檢測" AutomationProperties.Name="單站檢測"
                            Padding="10,10" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="24"/>
                            <TextBlock x:Name="InspectionNavLabel" Text="單站檢測" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="8,12,4,4">
                    <TextBlock Text=".NET Framework 4.7.2" Foreground="{StaticResource Muted}"
                               FontSize="10" TextWrapping="Wrap"/>
                    <TextBlock Text="獨立精簡版" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 上方左半部全為操作圖示，右半部顯示配方／站別／檢測狀態。 -->
        <Border x:Name="MainHeaderBar" Grid.Row="0" Grid.ColumnSpan="2"
                Panel.ZIndex="18" Background="{StaticResource HudHeaderGradient}"
                BorderBrush="{StaticResource HudBorder}" BorderThickness="0,0,0,1"
                Padding="10,6,17,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopIconButton}"
                            Click="OpenRecipeManager_Click" Content="&#xE8B7;"
                            AutomationProperties.Name="上方選擇配方"
                            ToolTip="選擇／管理 Recipe"/>
                    <Border Width="1" Height="30" Background="{StaticResource HudBorder}"
                            Margin="6,0"/>
                    <Button Style="{StaticResource TopIconButton}"
                            Click="OpenDatabaseSetup_Click" Content="&#xE8B9;"
                            IsEnabled="{Binding IsRecipeActive}"
                            AutomationProperties.Name="上方各站圖庫"
                            ToolTip="各站 OK／NG 圖庫設定"/>
                    <Button Style="{StaticResource TopIconButton}"
                            Command="{Binding ExportTestImagesCommand}" Content="&#xE74E;"
                            AutomationProperties.Name="匯出報表"
                            ToolTip="匯出目前單站 Excel 檢測報表"/>
                    <Button Style="{StaticResource TopIconButton}"
                            Command="{Binding ShowTestImageResultsCommand}" Content="&#xE8A1;"
                            AutomationProperties.Name="檢視結果"
                            ToolTip="查看目前單站檢測結果"/>
                    <Border Width="1" Height="30" Background="{StaticResource HudBorder}"
                            Margin="6,0"/>
                    <ToggleButton x:Name="TopSettingsToggle"
                                  Style="{StaticResource TopIconToggle}"
                                  Content="&#xE713;"
                                  IsChecked="{Binding IsSettingsPanelOpen, Mode=TwoWay}"
                                  AutomationProperties.Name="上方設定"
                                  ToolTip="檢測／顯示／站別設定"/>
                </StackPanel>
                <Border Grid.Column="2" Width="235" Background="#E8F8FE" CornerRadius="8"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Padding="12,5" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="目前 Recipe" FontSize="10"
                                   Foreground="{StaticResource HudTextSoft}"/>
                        <TextBlock Text="{Binding CurrentRecipe.Name, TargetNullValue=尚未載入 Recipe}"
                                   FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"
                                   Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentRecipe.Name}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,15,0"
                            MinWidth="100">
                    <TextBlock Text="站別" FontSize="10" Foreground="{StaticResource HudTextSoft}"/>
                    <TextBlock Text="{Binding CurrentStationStatusText}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HudText}"
                               Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding RecipeConfigurationSummary}" FontSize="10"
                               Foreground="{StaticResource HudAccentStrong}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Width="159">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding GlobalStatusBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="檢測狀態" Foreground="{StaticResource HudTextSoft}"
                                   FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="{Binding GlobalRunStatusText}"
                               Foreground="{StaticResource HudText}" FontSize="11"
                               FontWeight="SemiBold" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding GlobalRunStatusText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compact settings panel with clear sections and a close action. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Panel.ZIndex="20"
                Width="402"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="231,8,0,0"
                Background="White"
                BorderBrush="{StaticResource HudBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0"
                Effect="{StaticResource CardShadow}"
                Visibility="{Binding IsSettingsPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Border CornerRadius="12,12,0,0" Background="{StaticResource HudHeaderGradient}"
                        Padding="16,12,12,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="×" Width="31" Height="29"
                                MinHeight="0" Padding="0" FontSize="18"
                                Click="CloseSettingsPanel_Click" ToolTip="收合設定面板"
                                AutomationProperties.Name="關閉設定面板"/>
                        <StackPanel>
                            <TextBlock Text="設定" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource HudText}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            <TabControl FlowDirection="LeftToRight" Margin="14,11,14,0">
                <TabItem Header="檢測">
                    <StackPanel Margin="12" FlowDirection="LeftToRight">
                        <TextBlock Text="項目" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7"/>
                        <ComboBox ItemsSource="{Binding InspectionModeItems}"
                                  SelectedItem="{Binding DetectionMode, Mode=TwoWay}"
                                  AutomationProperties.Name="檢測項目"
                                  Margin="0,0,0,12"/>
                        <TextBlock Text="亮度模式不計算銳利度"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="顯示">
                    <StackPanel Margin="12" FlowDirection="LeftToRight">
                        <TextBlock Text="檢測畫面" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox Content="顯示 ROI 資訊"
                                  IsChecked="{Binding ShowRoiPanel, Mode=TwoWay}"
                                  Margin="0,2,0,15"/>
                        <TextBlock Text="批次結果縮圖" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding BatchPreviewModeItems}"
                                  SelectedItem="{Binding BatchPreviewMode, Mode=TwoWay}"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="站別">
                    <StackPanel Margin="12" FlowDirection="LeftToRight">
                        <TextBlock Text="目前站數" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7"/>
                        <ComboBox x:Name="StationCountCombo" AutomationProperties.Name="站數"
                                  ItemsSource="{Binding StationCountOptions}"
                                  SelectedItem="{Binding StationCount, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>
                        <TextBlock Text="切回 8 站仍保留第 9、10 站設定。"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
                <Border Height="10" Background="Transparent"/>
            </StackPanel>
        </Border>

        <Grid x:Name="InspectionPage" Grid.Column="1" Grid.Row="1" Margin="15,7,15,12"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="322"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#111F2C"
                        BorderBrush="#638EA3"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="5"
                        PreviewMouseWheel="MainImage_PreviewMouseWheel">
                    <Viewbox Stretch="Uniform">
                        <Grid>
                            <Image Source="{Binding DisplayImage}" Stretch="None" IsHitTestVisible="False"/>
                            <Canvas x:Name="MainRoiCanvas"
                                    Width="{Binding DisplayImage.PixelWidth}"
                                    Height="{Binding DisplayImage.PixelHeight}"
                                    Background="Transparent"
                                    MouseLeftButtonDown="MainRoiCanvas_MouseLeftButtonDown"
                                    MouseMove="MainRoiCanvas_MouseMove"
                                    MouseLeftButtonUp="MainRoiCanvas_MouseLeftButtonUp">
                                    <Rectangle Stroke="#FF43A047"
                                               StrokeThickness="{Binding StrokeThickness}"
                                               Width="{Binding RectWidth}"
                                               Height="{Binding RectHeight}"
                                               Canvas.Left="{Binding RectX}"
                                               Canvas.Top="{Binding RectY}"
                                               IsHitTestVisible="False"/>
                                    <Rectangle Stroke="#FF039BE5"
                                               StrokeThickness="{Binding StrokeThickness2}"
                                               Width="{Binding RectWidth2}"
                                               Height="{Binding RectHeight2}"
                                               Canvas.Left="{Binding RectX2}"
                                               Canvas.Top="{Binding RectY2}"
                                               IsHitTestVisible="False"/>
                                    <Rectangle Stroke="#FFE53935"
                                               Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               StrokeThickness="{Binding StrokeThickness3}"
                                               Width="{Binding RectWidth3}"
                                               Height="{Binding RectHeight3}"
                                               Canvas.Left="{Binding RectX3}"
                                               Canvas.Top="{Binding RectY3}"
                                               IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>
                <Border Grid.Row="1" Margin="0,7,0,0" Padding="9,6"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="2,0,2,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding CreateStationParametersCommand}"
                                        IsEnabled="{Binding IsRecipeActive}"
                                        Content="新增參數"
                                        AutomationProperties.Name="新增本站參數"
                                        ToolTip="使用本站 OK 圖建立參數，1 張即可。"
                                        Margin="0,0,6,0" Padding="10,4"
                                        Background="{StaticResource BlueSoft}"
                                        BorderBrush="{StaticResource Blue}"/>
                                <Button Command="{Binding ResetCurrentParametersCommand}"
                                        IsEnabled="{Binding CanEditRoi}"
                                        Content="重設參數"
                                        ToolTip="直接使用目前站別的全部 OK 圖片重算；缺少有效圖庫才用檔案總管選取資料夾。"
                                        Padding="10,4">
                                </Button>
                                <Button Content="定位樣板…"
                                        Click="OpenStationPatterns_Click"
                                        IsEnabled="{Binding HasCurrentProfile}"
                                        AutomationProperties.Name="管理定位樣板"
                                        ToolTip="加入反面或其他姿態的定位樣板；不覆蓋原始 pattern.jpg"
                                        Margin="6,0,0,0" Padding="10,4"/>
                            </StackPanel>
                            <TextBlock Text="站" FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}" Margin="2,2,0,0"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding StationSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0">
                                        <Button Content="{Binding Number}" Padding="0" MinWidth="0" MinHeight="32"
                                                Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Number}"
                                                IsEnabled="{Binding DataContext.IsRecipeActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="切換站別">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Margin="0,6,0,0" Padding="7,4"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="OpenDatabaseSetup_Click" IsEnabled="{Binding IsRecipeActive}"
                                    Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    ToolTip="開啟各站圖庫設定" AutomationProperties.Name="圖庫設定">
                                <Grid Width="23" Height="21">
                                    <Path Data="M2,5 L9,5 L11,8 L22,8 L22,19 L2,19 Z"
                                          Width="18" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Stretch="Fill" Fill="#F0E6FA" Stroke="#8A3AB9" StrokeThickness="1.5"/>
                                    <Border Width="13" Height="13" Background="{StaticResource Surface}" CornerRadius="7"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="#8A3AB9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Command="{Binding TestImageCommand}"
                                    Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    ToolTip="選擇資料夾；只建立圖片清單，不會立即測試"
                                    AutomationProperties.Name="選擇資料夾">
                                <Path Data="M2,5 L9,5 L11,8 L22,8 L22,19 L2,19 Z"
                                      Width="18" Height="14" Stretch="Fill"
                                      Fill="{StaticResource BlueSoft}" Stroke="{StaticResource Blue}" StrokeThickness="1.5"/>
                            </Button>
                            <Button Command="{Binding SelectSingleImageCommand}"
                                    Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    ToolTip="選擇單張圖片；只顯示圖片，不會立即測試"
                                    AutomationProperties.Name="選擇單張圖片">
                                <Viewbox Width="18" Height="16">
                                    <Grid Width="24" Height="20">
                                        <Border BorderBrush="{StaticResource Blue}" BorderThickness="1.7" CornerRadius="2"/>
                                        <Ellipse Width="3.5" Height="3.5" Fill="{StaticResource Blue}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,3,0,0"/>
                                        <Path Data="M3,17 L9,10 L13,14 L17,8 L22,17 Z" Fill="#B9D8FF" Stroke="{StaticResource Blue}" StrokeThickness="1.2"/>
                                    </Grid>
                                </Viewbox>
                            </Button>
                            <Button Command="{Binding OpenStationDatabaseCommand}" CommandParameter="OK" Content="OK DB"
                                    IsEnabled="{Binding IsRecipeActive}" Height="34" MinHeight="0" Padding="7,0" Margin="2"
                                    Foreground="#248A3D" ToolTip="載入目前站別的 OK 圖庫"/>
                            <Button Command="{Binding OpenStationDatabaseCommand}" CommandParameter="NG" Content="NG DB"
                                    IsEnabled="{Binding IsRecipeActive}" Height="34" MinHeight="0" Padding="7,0" Margin="2"
                                    Foreground="#D32F2F" ToolTip="載入目前站別的 NG 圖庫"/>
                            <Button Command="{Binding OpenStationDatabaseCommand}" CommandParameter="Station" Content="本站圖片"
                                    IsEnabled="{Binding IsRecipeActive}" Height="34" MinHeight="0" Padding="7,0" Margin="2"
                                    ToolTip="載入站號資料夾內未分類的圖片"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Click="OpenTestImagePicker_Click"
                                Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                ToolTip="開啟圖片清單，只切換預覽"
                                AutomationProperties.Name="圖片清單"/>
                        <Button Command="{Binding PreviousTestImageCommand}"
                                Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                IsEnabled="{Binding CanNavigatePrevious}" ToolTip="上一張圖片"/>
                        <TextBlock Text="{Binding TestImageInfo}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="78" TextAlignment="Center" Margin="5,0"/>
                        <Button Command="{Binding NextTestImageCommand}"
                                Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="38" Height="34" MinHeight="0" Padding="0" Margin="2"
                                IsEnabled="{Binding CanNavigateNext}" ToolTip="下一張圖片"/>
                        <Button Command="{Binding StartContinuousTestCommand}"
                                FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="38" Height="34" MinHeight="0" Padding="0" Margin="8,2,2,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="&#xE768;"/>
                                    <Setter Property="ToolTip" Value="開始連續測試目前清單中的圖片"/>
                                    <Setter Property="AutomationProperties.Name" Value="開始連續測試"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContinuousTestRunning}" Value="True">
                                            <Setter Property="Content" Value="&#xE769;"/>
                                            <Setter Property="ToolTip" Value="暫停連續測試；再次按下可繼續"/>
                                            <Setter Property="AutomationProperties.Name" Value="暫停連續測試"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ShowTestImageResultsByStatusCommand}" CommandParameter="ALL"
                                    Content="ALL" Width="46" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    ToolTip="檢視全部檢測結果" AutomationProperties.Name="檢視全部結果"/>
                            <Button Command="{Binding ShowTestImageResultsByStatusCommand}" CommandParameter="OK"
                                    Content="OK" Width="42" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    Foreground="#248A3D" ToolTip="只檢視 OK 結果" AutomationProperties.Name="檢視 OK 結果"/>
                            <Button Command="{Binding ShowTestImageResultsByStatusCommand}" CommandParameter="NG"
                                    Content="NG" Width="42" Height="34" MinHeight="0" Padding="0" Margin="2"
                                    Foreground="#D32F2F" ToolTip="只檢視 NG 結果" AutomationProperties.Name="檢視 NG 結果"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 避免將可編輯閾值作為單站頁預設內容；檢測員先看本站狀態與結果。 -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="7" Padding="14,12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,9">
                                <TextBlock Text="判定範圍" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DetectionMode}"
                                           FontSize="11" Foreground="{StaticResource Blue}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Border Background="#F7FAFC" CornerRadius="5" Padding="10,10"
                                    BorderBrush="#DEE8ED" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="亮度" Style="{StaticResource FieldLabel}"/>
                                        <StackPanel Visibility="{Binding HasCurrentProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding EffectiveBrightnessMin, StringFormat={}{0:F2}}"
                                                       FontSize="20" Foreground="{StaticResource Text}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EffectiveBrightnessMax, StringFormat=至 {0:F2}}"
                                                       FontSize="12" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                        <TextBlock Text="尚未校準" Foreground="{StaticResource Orange}"
                                                   FontSize="15" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCurrentProfile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="已判定" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="{Binding TotalTestImageCount, StringFormat={}{0:N0} 張}"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Blue}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Expander x:Name="AdvancedSettingsExpander" IsExpanded="False"
                              AutomationProperties.Name="進階判定設定"
                              Margin="0,0,0,5">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="參數設定" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource Text}"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,9,0,0">
                    <GroupBox Header="亮度規格">
                        <StackPanel Margin="0">
                            <TextBlock Text="判定方式" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LimitModeItems}"
                                      SelectedItem="{Binding BrightnessLimitMode, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="基準值 / 標準差" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource ReadOnlyValue}" Margin="0,0,0,8">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F2} / σ {1:F2}">
                                        <Binding Path="BrightnessBaseValue"/>
                                        <Binding Path="CurrentProfile.BrightnessSigma"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IsBrightnessPercentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="下限偏差 %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BrightnessPercentLower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="上限偏差 %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BrightnessPercentUpper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IsBrightnessFixedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="固定下限" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BrightnessFixedMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="固定上限" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BrightnessFixedMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource ReadOnlyValue}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="有效範圍: {0:F2} ~ {1:F2}">
                                        <Binding Path="EffectiveBrightnessMin"/>
                                        <Binding Path="EffectiveBrightnessMax"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="銳利度規格"
                              Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0">
                            <TextBlock Text="判定方式" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LimitModeItems}"
                                      SelectedItem="{Binding SharpnessLimitMode, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="基準值 / 標準差" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource ReadOnlyValue}" Margin="0,0,0,8">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F2} / σ {1:F2}">
                                        <Binding Path="SharpnessBaseValue"/>
                                        <Binding Path="CurrentProfile.SharpnessSigma"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <StackPanel Visibility="{Binding IsSharpnessPercentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="下限偏差 %" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SharpnessPercentLower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                         Margin="0,0,0,8"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsSharpnessFixedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="固定下限" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SharpnessFixedMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                         Margin="0,0,0,8"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EffectiveSharpnessMin, StringFormat='有效下限: {0:F2}'}"
                                       Style="{StaticResource ReadOnlyValue}"/>
                        </StackPanel>
                    </GroupBox>

                    <Button Command="{Binding SaveInspectionSettingsCommand}"
                            Content="儲存檢測設定"
                            Style="{StaticResource HudPrimaryButton}"
                            Margin="0,0,0,14"
                            ToolTip="只有修改判定閾值後，才需要儲存到目前設定檔。"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Dark machine telemetry strip: not a pastel dashboard, actions remain clickable. -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                    Background="#0B2232" BorderBrush="#2D596D" BorderThickness="1"
                    CornerRadius="7" Padding="18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource YieldCardButtonStyle}"
                                Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ShowTestImageResultsByStatusCommand}"
                                CommandParameter="OK" ToolTip="檢視 OK 結果"
                                AutomationProperties.Name="檢視 OK 結果">
                            <DockPanel Margin="9,2,12,2">
                                <TextBlock Text="OK" Foreground="#6AD4B0" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding OverallOkCount}" Foreground="#EAF8FF"
                                               FontFamily="Consolas" FontSize="24"
                                               TextAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OverallOkRateText}" Foreground="#74CFAF"
                                               FontFamily="Consolas" FontSize="11" TextAlignment="Right"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Border Grid.Column="1" Background="#3E6071" Margin="0,8"/>
                        <Button Grid.Column="2" Style="{StaticResource YieldCardButtonStyle}"
                                Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ShowTestImageResultsByStatusCommand}"
                                CommandParameter="NG" ToolTip="檢視 NG 結果"
                                AutomationProperties.Name="檢視 NG 結果">
                            <DockPanel Margin="12,2">
                                <TextBlock Text="NG" Foreground="#FF9099" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding OverallNgCount}" Foreground="#EAF8FF"
                                               FontFamily="Consolas" FontSize="24"
                                               TextAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OverallNgRateText}" Foreground="#FF9AA1"
                                               FontFamily="Consolas" FontSize="11" TextAlignment="Right"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Border Grid.Column="3" Background="#3E6071" Margin="0,8"/>
                        <StackPanel Grid.Column="4" Margin="14,3,10,3" VerticalAlignment="Center">
                            <TextBlock Text="已判定" Foreground="#8FAEBE" FontSize="11"/>
                            <TextBlock Text="{Binding TotalTestImageCount, StringFormat={}{0:N0}}"
                                       Foreground="#EAF8FF" FontFamily="Consolas"
                                       FontSize="24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="5" Background="#3E6071" Margin="0,8"/>
                        <StackPanel Grid.Column="6" Margin="16,3,0,3" VerticalAlignment="Center">
                            <TextBlock Text="亮度" Foreground="#8FAEBE" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TestImageBrightness, StringFormat={}{0:F2}}"
                                           Foreground="#EAF8FF" FontFamily="Consolas"
                                           FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TestImageBrightnessDeltaPercentText}"
                                           Foreground="#7EC3DC" FontFamily="Consolas"
                                           FontSize="11" Margin="10,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="9,9,9,0"
                          Visibility="{Binding IsAnalyzingTestImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AnalysisProgressText}" Foreground="#A5C5D1"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ProgressBar Grid.Column="1" Minimum="0"
                                     Maximum="{Binding AnalysisProgressMaximum}"
                                     Value="{Binding AnalysisProgressValue}" Height="4"
                                     Foreground="#1CBDE3" Background="#335568"
                                     BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 八／十站共覽：使用同一 Recipe／站別狀態，不另建第二份資料。 -->
        <Grid x:Name="StationOverviewPage" Grid.Column="1" Grid.Row="1" 
              Background="{StaticResource HudPageGradient}" TextElement.FontFamily="Segoe UI">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <!-- 首頁不是設定頁：只留配方、實測統計與開始／停止鍵。 -->
            <Border Margin="23,17,23,13" CornerRadius="11" Padding="15,10"
                    Background="{StaticResource HudHeaderGradient}"
                    BorderBrush="{StaticResource HudBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RunMultiStationInspectionCommand}"
                                IsEnabled="{Binding IsRecipeActive}"
                                Content="▶  開始"
                                AutomationProperties.Name="測試勾選站別"
                                ToolTip="逐站測試勾選的站別；使用每站 OK／NG 圖庫影像和該站檢測 Profile 判定，未校準站跳過。"
                                Background="#D2F5FF" BorderBrush="{StaticResource HudAccentStrong}"
                                Foreground="{StaticResource HudAccentStrong}"
                                FontWeight="SemiBold" Padding="16,7" Margin="0,0,7,0"/>
                        <Button Command="{Binding StopMultiStationInspectionCommand}"
                                IsEnabled="{Binding IsMultiStationTesting}" Content="停止"
                                AutomationProperties.Name="停止多站測試" Padding="11,7"
                                BorderBrush="{StaticResource HudNg}" Foreground="#B53048"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource HudAccent}" Width="4"
                                CornerRadius="2" Margin="0,2,13,2"/>
                        <TextBlock Text="總覽"
                                   FontWeight="Bold" FontSize="17" VerticalAlignment="Center"
                                   Foreground="{StaticResource HudText}" Margin="0,0,19,0"/>
                        <TextBlock Text="{Binding MultiStationTotal}" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudAccentStrong}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding MultiStationProgress}"
                           Foreground="{StaticResource HudTextSoft}" FontSize="11"
                           Margin="16,4,0,0" MaxHeight="16" TextTrimming="CharacterEllipsis"/>
            </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="17,0,17,15">
                <ItemsControl ItemsSource="{Binding StationSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5,6,11" Height="313">
                            <Button Style="{StaticResource HudStationCard}" Height="313"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    IsEnabled="{Binding DataContext.IsRecipeActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Number}"
                                    Click="OverviewStation_Click" AutomationProperties.Name="{Binding Number, StringFormat=開啟第 {0} 站檢測}"
                                    ToolTip="進入單站檢測；不會自動執行檢測">
                                <Grid Margin="11,10,11,11">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="4,1,4,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" CornerRadius="2" Background="{StaticResource HudAccent}"
                                                    Margin="0,1,9,1"/>
                                            <TextBlock Text="{Binding Number}" FontSize="20"
                                                       FontWeight="Bold" Foreground="{StaticResource HudText}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,0,27,0"
                                                    VerticalAlignment="Center" ToolTip="{Binding BatchDetails}">
                                            <Ellipse Width="7" Height="7" Fill="{Binding BatchStatusBrush}"
                                                     Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding BatchStatus}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource HudTextSoft}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Chao8Side's dark camera viewport and thin cyan border. -->
                                    <Border Grid.Row="1" Background="{StaticResource HudCameraGradient}"
                                            CornerRadius="4" BorderBrush="#2A88AE"
                                            BorderThickness="1" Margin="0,0,0,9" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="4"/>
                                        </Grid>
                                    </Border>
                                    <!-- Single shared telemetry strip, no stacked pastel KPI cards. -->
                                    <Grid Grid.Row="2" Margin="0,2,0,7" Background="#0D2737">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="10,8" VerticalAlignment="Center">
                                            <TextBlock Text="OK" Foreground="#64D6AD" FontSize="10"/>
                                            <TextBlock Text="{Binding BatchOkText}" Foreground="#F0FAFE"
                                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="21"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#315062" Margin="0,9"/>
                                        <StackPanel Grid.Column="2" Margin="10,8" VerticalAlignment="Center">
                                            <TextBlock Text="NG" Foreground="#FF8796" FontSize="10"/>
                                            <TextBlock Text="{Binding BatchNgText}" Foreground="#F0FAFE"
                                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="21"/>
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="#315062" Margin="0,9"/>
                                        <StackPanel Grid.Column="4" Margin="10,8" VerticalAlignment="Center">
                                            <TextBlock Text="良率" Foreground="#8FB7C9" FontSize="10"/>
                                            <TextBlock Text="{Binding BatchYield}" Foreground="#58D7F4"
                                                       FontFamily="Consolas" FontWeight="SemiBold" FontSize="19"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Grid.Row="3" Height="3" Minimum="0" Maximum="100"
                                                 Value="{Binding BatchYieldValue, Mode=OneWay}"
                                                 Foreground="#18BFD7"
                                                 Background="#C5DDE5" BorderThickness="0" Margin="0"
                                                 IsHitTestVisible="False"/>
                                </Grid>
                            </Button>
                            <CheckBox IsChecked="{Binding IncludeInBatch, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,15,15,0" ToolTip="勾選後列入本次多站檢測"
                                      AutomationProperties.Name="{Binding Number, StringFormat=勾選第 {0} 站測試}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

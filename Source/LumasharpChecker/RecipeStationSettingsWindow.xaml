<Window x:Class="LumasharpChecker.RecipeStationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="本站設定" Width="850" Height="470"
        MinWidth="720" MinHeight="420" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft JhengHei UI" FontSize="13"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="本站設定" Style="{DynamicResource HudSectionTitle}"/>
            <TextBlock Text="{Binding CurrentInspectionName, StringFormat='目前配方與站別：{0}'}"
                       Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="配方專屬站別設定" IsEnabled="{Binding IsRecipeActive}">
            <StackPanel>
                <TextBlock Text="{Binding CurrentStationSettingsLabel, StringFormat='目前配方此站設定：{0}'}"
                           FontWeight="SemiBold" Foreground="{StaticResource Text}"
                           Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding StationSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Number}"
                                    Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Number}"
                                    Margin="0,0,8,8" MinWidth="52" Padding="10,7">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="下拉選單會顯示本站原本套用的共用範本；選擇其他範本後按「套用所選範本」，會複製到目前配方的本站。若目前設定為配方專屬，表示沒有共用範本來源。"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Items}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedRecipeTemplate, Mode=TwoWay}"
                              VerticalAlignment="Top">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                    <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                        <Button Content="新增設定檔" Command="{Binding AddNewProfileCommand}" Margin="0,0,8,0"/>
                        <Button Content="刪除共用範本" Command="{Binding DeleteSelectedRecipeTemplateCommand}"
                                IsEnabled="{Binding HasSelectedRecipeTemplate}" Margin="0,0,8,0"/>
                        <Button Content="套用所選範本" Command="{Binding ApplyLibraryProfileToStationCommand}"
                                IsEnabled="{Binding CanApplyLibraryProfileToStation}"
                                Background="{StaticResource Blue}" Foreground="White" BorderBrush="{StaticResource Blue}"/>
                    </WrapPanel>
                </Grid>
                <TextBlock Text="{Binding StationStatusMessage}" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding SaveSettingsMessage}" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button DockPanel.Dock="Right" Content="完成" MinWidth="100"
                    Style="{DynamicResource HudPrimaryButton}" Click="Done_Click"/>
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="LumasharpChecker.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作業圖庫" Width="1000" Height="650" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft JhengHei UI" FontSize="13"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">
    <Grid Margin="19,16,19,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,14">
            <Button DockPanel.Dock="Right" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                    FontSize="16" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"
                    Click="Settings_Click" ToolTip="設定每個 Recipe 獨立的檢測圖檔輸出路徑"
                    Style="{DynamicResource HudSecondaryButton}"
                    AutomationProperties.Name="作業圖庫輸出資料夾設定"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding InspectionImageOutputFolderDisplay}"
                       VerticalAlignment="Center" FontSize="10" MaxWidth="260"
                       Margin="4,0,8,0" Foreground="{DynamicResource Muted}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding InspectionImageOutputFolderDisplay}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentRecipe.Name, TargetNullValue=尚未選擇配方}"
                       VerticalAlignment="Center" FontSize="12" MaxWidth="350"
                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding CurrentRecipe.Name}"/>
            <TextBlock Text="作業圖庫" FontWeight="SemiBold" FontSize="21"
                       Foreground="{DynamicResource Text}"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="9"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="11,8"
                Margin="0,0,0,12" IsEnabled="{Binding IsRecipeActive}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="批次" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                <TextBox Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"
                         Text="{Binding DatabaseDayFolderDisplay, Mode=OneWay}"
                         ToolTip="{Binding DatabaseDayFolderDisplay}"
                         AutomationProperties.Name="目前批次圖庫資料夾"/>
                <Button Grid.Column="2" Content="套用…" Margin="9,0,0,0"
                        Command="{Binding SelectDatabaseDayFolderCommand}"
                        Style="{DynamicResource HudSecondaryButton}"
                        AutomationProperties.Name="批次選取所有站別圖庫"/>
                <Button Grid.Column="3" Content="訓練圖庫…" Margin="6,0,0,0"
                        Command="{Binding ApplyTrainingImageToCurrentRecipeCommand}"
                        ToolTip="依產品前綴選擇各站訓練圖庫版本，套用至目前配方"
                        AutomationProperties.Name="套用訓練圖庫"/>
                <Button Grid.Column="4" Content="匯入…" Margin="6,0,0,0"
                        Command="{Binding ImportTrainingImageCommand}"
                        AutomationProperties.Name="匯入訓練圖庫"/>
                <Button Grid.Column="5" Content="匯入作業圖庫…" Margin="6,0,0,0"
                        Command="{Binding ImportWorkDatabaseCommand}"
                        ToolTip="從外觀通共用報告格式（月\日\n站，可含 OK／NG 子資料夾）匯入各站圖庫"
                        AutomationProperties.Name="匯入作業圖庫"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="9"
                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                Padding="13,12" IsEnabled="{Binding IsRecipeActive}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="1,0,4,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="站" Foreground="{DynamicResource Muted}"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="ALL" FontWeight="SemiBold"
                               Foreground="{DynamicResource Blue}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="OK" FontWeight="SemiBold"
                               Foreground="#078F5A"/>
                    <TextBlock Grid.Column="3" Text="NG" FontWeight="SemiBold"
                               Foreground="#D74758"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding StationDatabasePaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                        Padding="1,5" MinHeight="46">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}"
                                                   FontWeight="SemiBold" FontSize="18"
                                                   Foreground="{DynamicResource Blue}"
                                                   VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding AllStatusBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                     ToolTip="{Binding AllStatus}"/>
                                            <TextBox Grid.Column="1" Text="{Binding AllPathDisplay, Mode=OneWay}"
                                                     IsReadOnly="True" VerticalContentAlignment="Center"
                                                     ToolTip="{Binding AllPath}" FontSize="11"
                                                     Padding="7,5" AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站 ALL 路徑}"/>
                                            <Button Grid.Column="2" Content="選擇" Click="ChooseAllFolder_Click"
                                                    Style="{DynamicResource HudSecondaryButton}"
                                                    Margin="6,0,1,0" MinHeight="30" Padding="10,4"
                                                    ToolTip="載入所選資料夾內全部圖片；若包含 OK／NG 子資料夾，會自動填入對應路徑。"
                                                    AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站選擇 ALL 圖庫}"/>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding OkStatusBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                     ToolTip="{Binding OkStatus}"/>
                                            <TextBox Grid.Column="1" Text="{Binding OkPathDisplay, Mode=OneWay}"
                                                     IsReadOnly="True" VerticalContentAlignment="Center"
                                                     ToolTip="{Binding OkPath}" FontSize="11"
                                                     Padding="7,5" AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站 OK 路徑}"/>
                                            <Button Grid.Column="2" Content="選擇" Click="ChooseOkFolder_Click"
                                                    Style="{DynamicResource HudSecondaryButton}"
                                                    Margin="6,0,1,0" MinHeight="30" Padding="10,4"
                                                    AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站選擇 OK 圖庫}"/>
                                        </Grid>
                                        <Grid Grid.Column="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding NgStatusBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                     ToolTip="{Binding NgStatus}"/>
                                            <TextBox Grid.Column="1" Text="{Binding NgPathDisplay, Mode=OneWay}"
                                                     IsReadOnly="True" VerticalContentAlignment="Center"
                                                     ToolTip="{Binding NgPath}" FontSize="11"
                                                     Padding="7,5" AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站 NG 路徑}"/>
                                            <Button Grid.Column="2" Content="選擇" Click="ChooseNgFolder_Click"
                                                    Margin="6,0,1,0" MinHeight="30" Padding="10,4"
                                                    AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站選擇 NG 圖庫}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="2,12,2,0">
            <Button DockPanel.Dock="Right" Content="完成" MinWidth="96"
                    Click="Done_Click" Style="{DynamicResource HudPrimaryButton}"
                    Margin="12,0,0,0"/>
            <TextBlock Text="{Binding DatabaseSaveMessage}" FontSize="11"
                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabaseSaveMessage}"
                       AutomationProperties.Name="作業圖庫儲存狀態"/>
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="LumasharpChecker.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作業圖庫" Width="1000" Height="650" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft JhengHei UI" FontSize="13"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">
    <Window.Resources>
        <Style x:Key="HudSettingsToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HudBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HudAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BlueSoft}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="19,16,19,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,14">
            <ToggleButton x:Name="SettingsButton" DockPanel.Dock="Right" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                          FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"
                          ToolTip="匯入與輸出設定" Style="{StaticResource HudSettingsToggleButton}"
                          AutomationProperties.Name="作業圖庫設定"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentRecipe.Name, TargetNullValue=尚未選擇配方}"
                       VerticalAlignment="Center" FontSize="12" MaxWidth="350"
                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding CurrentRecipe.Name}"/>
            <TextBlock Text="作業圖庫" FontWeight="SemiBold" FontSize="21"
                       Foreground="{DynamicResource Text}"/>
        </DockPanel>

        <Popup x:Name="SettingsPopup" Grid.Row="0"
               IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom" HorizontalOffset="-286" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border Width="330" Padding="16" CornerRadius="10"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="作業圖庫設定" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,0,0,13"/>
                    <TextBlock Text="匯入" FontWeight="SemiBold"
                               Foreground="{DynamicResource Blue}"/>
                    <TextBlock Text="共用作業圖庫來源路徑" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SharedReportSourceFolderDisplay}"
                               FontSize="11" Foreground="{DynamicResource Muted}"
                               TextWrapping="Wrap" ToolTip="{Binding SharedReportSourceFolderDisplay}"
                               Margin="0,4,0,7"/>
                    <Button Content="設定作業圖庫來源…" Click="ConfigureSharedReportSourceFolder_Click"
                            HorizontalAlignment="Left" Padding="12,6"
                            Style="{DynamicResource HudSecondaryButton}"
                            AutomationProperties.Name="設定作業圖庫來源路徑"/>
                    <CheckBox Content="有新日期時自動更新圖庫"
                              IsChecked="{Binding AutoUpdateLatestSharedReportDay, Mode=TwoWay}"
                              ToolTip="啟動時立即檢查；偵測到資料夾變更後約 8 秒檢查，每 5 分鐘補查一次。檢測進行中暫緩更新。"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="有新日期時自動更新圖庫"/>
                    <TextBlock Text="資料夾變更安定後約 8 秒檢查；每 5 分鐘補查，檢測時暫緩更新。"
                               FontSize="11" Foreground="{DynamicResource Muted}"
                               TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,12"/>
                    <TextBlock Text="檢測輸出資料夾" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="{Binding InspectionImageOutputFolderDisplay}"
                               FontSize="11" Foreground="{DynamicResource Muted}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding InspectionImageOutputFolderDisplay}"
                               Margin="0,5,0,10"/>
                    <Button Content="設定輸出資料夾…" Click="ConfigureOutputFolder_Click"
                            HorizontalAlignment="Left" Padding="12,6"
                            Style="{DynamicResource HudSecondaryButton}"
                            AutomationProperties.Name="設定檢測輸出資料夾"/>
                </StackPanel>
            </Border>
        </Popup>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="9"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="11,8"
                Margin="0,0,0,12" IsEnabled="{Binding IsRecipeActive}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="批次" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                <TextBox Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"
                         Text="{Binding DatabaseDayFolderDisplay, Mode=OneWay}"
                         ToolTip="{Binding DatabaseDayFolderDisplay}"
                         AutomationProperties.Name="目前批次圖庫資料夾"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="9"
                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                Padding="13,12" IsEnabled="{Binding IsRecipeActive}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="圖庫" Foreground="{DynamicResource Muted}"
                               FontWeight="SemiBold" Margin="2,1,0,8"/>
                    <Button Content="套用" Command="{Binding SelectDatabaseDayFolderCommand}"
                            MinHeight="36" Margin="0,0,0,6"
                            Style="{DynamicResource HudSecondaryButton}"
                            ToolTip="選擇批次資料夾，套用各站圖庫"
                            AutomationProperties.Name="批次套用所有站別圖庫"/>
                    <Button Content="訓練" Command="{Binding ApplyTrainingImageToCurrentRecipeCommand}"
                            MinHeight="36" Margin="0,0,0,6"
                            Style="{DynamicResource HudSecondaryButton}"
                            ToolTip="選擇訓練圖庫並套用各站路徑"
                            AutomationProperties.Name="套用訓練圖庫"/>
                    <Button Content="作業" Command="{Binding ImportWorkDatabaseCommand}"
                            MinHeight="36" Margin="0,0,0,6"
                            Style="{DynamicResource HudSecondaryButton}"
                            ToolTip="讀取共用報告月／日／站圖庫"
                            AutomationProperties.Name="讀取作業圖庫"/>
                    <Button Content="讀取" Command="{Binding ImportExportedImageGalleryCommand}"
                            MinHeight="36" Margin="0,0,0,6"
                            Style="{DynamicResource HudPrimaryButton}"
                            ToolTip="讀取匯出圖庫；OK 資料夾列為 OK，其餘圖片全部列為 NG"
                            AutomationProperties.Name="讀取匯出圖庫"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="1,0,4,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="站" Foreground="{DynamicResource Muted}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="ALL 圖庫路徑" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Blue}"/>
                        <TextBlock Grid.Column="2" Text="分類狀態" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding StationDatabasePaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                        Padding="1,5">
                                    <Expander IsExpanded="False" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Margin="2,1,6,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Number}"
                                                           FontWeight="SemiBold" FontSize="18"
                                                           Foreground="{DynamicResource Blue}"
                                                           VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Margin="0,0,10,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="7" Height="7" Fill="{Binding AllStatusBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"
                                                             ToolTip="{Binding AllStatus}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding AllPathDisplay, Mode=OneWay}"
                                                             IsReadOnly="True" VerticalContentAlignment="Center"
                                                             ToolTip="{Binding AllPath}" FontSize="11"
                                                             Padding="7,5" AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站 ALL 路徑}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Content="選擇 ALL" Click="ChooseAllFolder_Click"
                                                            Style="{DynamicResource HudSecondaryButton}"
                                                            Margin="6,0,1,0" MinHeight="30" Padding="10,4"
                                                            ToolTip="選擇後會自動帶入其中的 OK／NG 子資料夾。"
                                                            AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站選擇 ALL 圖庫}"/>
                                                        <Button Content="清空本站" Tag="STATION" Click="ClearFolder_Click"
                                                                IsEnabled="{Binding HasAnyPath}" Margin="5,0,0,0" Padding="8,4" MinHeight="30"
                                                                Style="{DynamicResource HudSecondaryButton}" ToolTip="清除本站 ALL／OK／NG 路徑，保留原始圖片。"
                                                                AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站清空全部圖庫路徑}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource Bg}" CornerRadius="5"
                                                            Padding="7,4" Margin="0,0,5,0" ToolTip="{Binding OkStatus}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding OkStatusBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="OK" Foreground="#078F5A" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource Bg}" CornerRadius="5"
                                                            Padding="7,4" ToolTip="{Binding NgStatus}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding NgStatusBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="NG" Foreground="#D74758" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Margin="44,8,6,3">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="OK" Foreground="#078F5A" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding OkPathDisplay, Mode=OneWay}"
                                                         IsReadOnly="True" VerticalContentAlignment="Center"
                                                         ToolTip="{Binding OkPathToolTip}" FontSize="11" Padding="7,5"
                                                         AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站 OK 路徑}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="選擇" Click="ChooseOkFolder_Click"
                                                        Style="{DynamicResource HudSecondaryButton}"
                                                        Margin="6,0,1,0" MinHeight="30" Padding="10,4"
                                                        AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站選擇 OK 圖庫}"/>
                                                    <Button Content="清除" Tag="OK" Click="ClearFolder_Click"
                                                            IsEnabled="{Binding HasOkPath}" Margin="5,0,0,0" Padding="8,4" MinHeight="30"
                                                            Style="{DynamicResource HudSecondaryButton}" ToolTip="清除分類路徑及舊 ALL 指定，保留原始圖片。"
                                                            AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站清除 OK 圖庫路徑}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="NG" Foreground="#D74758" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding NgPathDisplay, Mode=OneWay}"
                                                         IsReadOnly="True" VerticalContentAlignment="Center"
                                                         ToolTip="{Binding NgPathToolTip}" FontSize="11" Padding="7,5"
                                                         AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站 NG 路徑}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="選擇" Click="ChooseNgFolder_Click"
                                                        Style="{DynamicResource HudSecondaryButton}"
                                                        Margin="6,0,1,0" MinHeight="30" Padding="10,4"
                                                        AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站選擇 NG 圖庫}"/>
                                                    <Button Content="清除" Tag="NG" Click="ClearFolder_Click"
                                                            IsEnabled="{Binding HasNgPath}" Margin="5,0,0,0" Padding="8,4" MinHeight="30"
                                                            Style="{DynamicResource HudSecondaryButton}" ToolTip="清除分類路徑及舊 ALL 指定，保留原始圖片。"
                                                            AutomationProperties.Name="{Binding Number, StringFormat=第 {0} 站清除 NG 圖庫路徑}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="2,12,2,0">
            <Button DockPanel.Dock="Right" Content="完成" MinWidth="96"
                    Click="Done_Click" Style="{DynamicResource HudPrimaryButton}"
                    Margin="12,0,0,0"/>
            <TextBlock Text="{Binding DatabaseSaveMessage}" FontSize="11"
                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabaseSaveMessage}"
                       AutomationProperties.Name="作業圖庫儲存狀態"/>
        </DockPanel>
    </Grid>
</Window>

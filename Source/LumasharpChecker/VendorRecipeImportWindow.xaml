<Window x:Class="LumasharpChecker.VendorRecipeImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原廠資料匯入" Width="900" Height="680"
        MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft JhengHei UI" FontSize="13"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="原廠資料匯入" Style="{DynamicResource HudSectionTitle}"/>
            <TextBlock Text="同名配方會比對更新，沒有的配方會新建。本站檢測設定會保留。"
                       Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding SourceRoot, StringFormat=來源：{0}}" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" Margin="0,8,0,0" ToolTip="{Binding SourceRoot}"/>
            <TextBlock Text="目的地：本機配方清單" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="選擇要匯入的資料夾" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="全選" Click="SelectAll_Click" Padding="10,5" Margin="4,0,0,0"/>
                            <Button Content="全不選" Click="SelectNone_Click" Padding="10,5" Margin="4,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Candidates}" BorderBrush="{StaticResource Line}"
                             Background="{StaticResource SurfaceSubtle}" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Folder.Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}"
                                                       FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DiffSummary}"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Margin="8,0,2,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="差異比對" FontWeight="SemiBold"/>
                        <TextBlock Text="開啟時自動比對；變更選取後會重新比對。"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                             AcceptsReturn="True" AcceptsTab="False" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                             FontSize="11" Padding="8" BorderBrush="{StaticResource Line}"
                             Background="{StaticResource SurfaceSubtle}"/>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="匯入／更新" MinWidth="110" IsEnabled="{Binding IsPreviewReady}"
                        Style="{DynamicResource HudPrimaryButton}" Click="Confirm_Click" Margin="0,0,8,0"/>
                <Button Content="取消" MinWidth="80" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>


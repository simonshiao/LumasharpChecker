<Window x:Class="LumasharpChecker.StationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="站別檢測設定" Width="1320" Height="850" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft JhengHei UI" FontSize="13"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,2,14">
            <TextBlock Text="站別檢測設定" Style="{DynamicResource HudSectionTitle}"/>
            <TextBlock Text="{Binding CurrentInspectionName, StringFormat='目前：{0}'}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource HudViewport}" BorderBrush="{DynamicResource HudBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="8">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Grid>
                            <Image Source="{Binding StationSettingsImage}" Stretch="None"/>
                            <Canvas x:Name="RoiCanvas" Width="{Binding StationSettingsImage.PixelWidth}" Height="{Binding StationSettingsImage.PixelHeight}"
                                    Background="Transparent" MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                                    MouseMove="RoiCanvas_MouseMove" MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp">
                                <Rectangle Stroke="#FF43A047" StrokeThickness="{Binding StrokeThickness}" Width="{Binding RectWidth}" Height="{Binding RectHeight}"
                                           Canvas.Left="{Binding RectX}" Canvas.Top="{Binding RectY}" IsHitTestVisible="False"/>
                                <Rectangle Stroke="#FF039BE5" StrokeThickness="{Binding StrokeThickness2}" Width="{Binding RectWidth2}" Height="{Binding RectHeight2}"
                                           Canvas.Left="{Binding RectX2}" Canvas.Top="{Binding RectY2}" IsHitTestVisible="False"/>
                                <Rectangle Stroke="#FFE53935" Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           StrokeThickness="{Binding StrokeThickness3}" Width="{Binding RectWidth3}" Height="{Binding RectHeight3}"
                                           Canvas.Left="{Binding RectX3}" Canvas.Top="{Binding RectY3}" IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="檢測區域" Padding="10">
                        <StackPanel>
                            <TextBlock Text="選擇要編輯的區域，再於圖片上拖曳框選。座標以原始圖片像素儲存。"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <RadioButton Content="定位 ROI" GroupName="RoiType" Tag="定位" IsChecked="True"
                                             Checked="RoiType_Checked" Foreground="#FF43A047" Margin="0,0,14,8"/>
                                <RadioButton Content="亮度 ROI" GroupName="RoiType" Tag="亮度"
                                             Checked="RoiType_Checked" Foreground="#FF039BE5" Margin="0,0,14,8"/>
                                <RadioButton Content="銳利度 ROI" GroupName="RoiType" Tag="銳利度"
                                             Checked="RoiType_Checked" Foreground="#FFE53935" Margin="0,0,0,8"
                                             IsEnabled="{Binding IsSharpnessEnabled}"/>
                            </WrapPanel>
                            <TextBlock x:Name="RoiCoordinateLabel" Text="拖曳圖片即可設定定位範圍" Style="{StaticResource ResultValue}"/>
                            <TextBlock Text="定位 ROI（綠）" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource ResultValue}"><TextBlock.Text><MultiBinding StringFormat="X {0}　Y {1}　W {2}　H {3}"><Binding Path="CurrentProfile.PatternMatchRoiX"/><Binding Path="CurrentProfile.PatternMatchRoiY"/><Binding Path="CurrentProfile.PatternMatchRoiW"/><Binding Path="CurrentProfile.PatternMatchRoiH"/></MultiBinding></TextBlock.Text></TextBlock>
                            <TextBlock Text="亮度 ROI（藍）" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource ResultValue}"><TextBlock.Text><MultiBinding StringFormat="X {0}　Y {1}　W {2}　H {3}"><Binding Path="CurrentProfile.EffectiveBrightnessRoiX"/><Binding Path="CurrentProfile.EffectiveBrightnessRoiY"/><Binding Path="CurrentProfile.EffectiveBrightnessRoiW"/><Binding Path="CurrentProfile.EffectiveBrightnessRoiH"/></MultiBinding></TextBlock.Text></TextBlock>
                            <TextBlock Text="銳利度 ROI（紅）" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Style="{StaticResource ResultValue}" Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock.Text><MultiBinding StringFormat="X {0}　Y {1}　W {2}　H {3}"><Binding Path="CurrentProfile.EffectiveSharpnessRoiX"/><Binding Path="CurrentProfile.EffectiveSharpnessRoiY"/><Binding Path="CurrentProfile.EffectiveSharpnessRoiW"/><Binding Path="CurrentProfile.EffectiveSharpnessRoiH"/></MultiBinding></TextBlock.Text></TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="設定檔庫" Padding="10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="選取基準設定並套用至本站；建立設定檔可沿用此站的影像與檢測區域。"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Items}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      AutomationProperties.Name="設定檔清單">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="SelectionChanged">
                                        <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ComboBox>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="新增設定檔" Command="{Binding AddNewProfileCommand}" Margin="0,0,8,8"/>
                                <Button Content="刪除設定檔" Command="{Binding DeleteSelectedProfileCommand}" Style="{StaticResource DestructiveButtonStyle}" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <Button Content="套用至本站" Command="{Binding ApplyLibraryProfileToStationCommand}"
                                    IsEnabled="{Binding CanApplyLibraryProfileToStation}" MinHeight="40"/>
                            <TextBlock Text="{Binding SaveSettingsMessage}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <Expander Header="基準摘要與進階數據" IsExpanded="False" Margin="0,12,0,0">
                        <GroupBox Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding DetectionMode, StringFormat='檢測模式：{0}'}" Style="{StaticResource ResultValue}"/>
                                <TextBlock Text="{Binding ImageSizeSummary}" Style="{StaticResource ResultValue}"/>
                                <TextBlock Style="{StaticResource ResultValue}"><TextBlock.Text><MultiBinding StringFormat="亮度平均 / σ：{0:F2} / {1:F2}"><Binding Path="CurrentProfile.BrightnessMean"/><Binding Path="CurrentProfile.BrightnessSigma"/></MultiBinding></TextBlock.Text></TextBlock>
                                <TextBlock Text="{Binding BrightnessCvSummary}" Style="{StaticResource ResultValue}"/>
                                <TextBlock Text="{Binding BrightnessPercentileSummary}" Style="{StaticResource ResultValue}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BrightnessRoiAreaSummary}" Style="{StaticResource ResultValue}"/>
                                <TextBlock Text="{Binding SharpnessCvSummary}" Style="{StaticResource ResultValue}" Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding SharpnessPercentileSummary}" Style="{StaticResource ResultValue}" TextWrapping="Wrap" Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding SharpnessRoiAreaSummary}" Style="{StaticResource ResultValue}" Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="百分位數" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding BaselinePercentileItems}" SelectedItem="{Binding SelectedBaselinePercentile, Mode=TwoWay}" Width="82"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentProfile.ModifyDateTime, StringFormat='編輯時間：{0}', TargetNullValue='編輯時間：-'}" Style="{StaticResource ResultValue}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="2,12,2,0" LastChildFill="False">
            <TextBlock Text="框選完成後會立即儲存至目前 Recipe 的本站。" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <Button Content="完成" Click="Done_Click" MinWidth="100" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>

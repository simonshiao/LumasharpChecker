<Window x:Class="LumasharpChecker.view.TestImageResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LumasharpChecker.view"
        Title="測試圖片結果"
        Height="600"
        Width="1080"
        MinHeight="460"
        MinWidth="860" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft JhengHei UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
    <Window.Resources>
        <local:DeferredThumbnailConverter x:Key="DeferredThumbnailConverter"/>
        <local:ResultStatusBrushConverter x:Key="ResultStatusBrushConverter"/>
        <Style x:Key="ResultStatusCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource ResultStatusBrushConverter}}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Bg}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ResultsTitle" Text="測試圖片結果"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}"
                   Margin="0,0,0,14"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="顯示結果" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ResultFilter" Width="150" SelectedValuePath="Tag" SelectedIndex="0"
                      SelectionChanged="ResultOptions_Changed" AutomationProperties.Name="結果篩選">
                <ComboBoxItem Content="全部" Tag="ALL"/>
                <ComboBoxItem Content="OK" Tag="OK"/>
                <ComboBoxItem Content="NG（含 Retest）" Tag="NG"/>
                <ComboBoxItem Content="僅 Retest" Tag="Retest"/>
            </ComboBox>
            <CheckBox x:Name="ShowThumbnails" Content="顯示縮圖" IsChecked="True" Margin="18,0,16,0"
                      VerticalAlignment="Center" Checked="ThumbnailOptions_Changed" Unchecked="ThumbnailOptions_Changed"
                      ToolTip="僅影響結果視窗載圖，不影響檢測時間。"/>
            <TextBlock x:Name="ResultCount" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="78"
                  RowHeaderWidth="0"
                  FontSize="14"
                  Background="White"
                  BorderBrush="{DynamicResource Line}"
                  BorderThickness="1"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="ThumbnailColumn" Header="縮圖" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="78"
                                    Height="62"
                                    Background="#FFECEFF1"
                                    BorderBrush="#FFCFD8DC"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource DeferredThumbnailConverter}}"
                                       Stretch="Uniform"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="站別" Binding="{Binding StationDisplay}" Width="92"/>
                <DataGridTextColumn Header="檔名" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="亮度" Binding="{Binding BrightnessDisplay}" Width="86"/>
                <DataGridTextColumn Header="下限" Binding="{Binding MinimumDisplay}" Width="86"/>
                <DataGridTextColumn Header="上限" Binding="{Binding MaximumDisplay}" Width="86"/>
                <DataGridTextColumn Header="結果" Binding="{Binding Result}" Width="86" ElementStyle="{StaticResource ResultStatusCellStyle}"/>
                <DataGridTextColumn Header="備註" Binding="{Binding Message}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>

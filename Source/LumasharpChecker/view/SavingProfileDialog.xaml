<Window x:Class="LumasharpChecker.view.SavingProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="儲存檢測設定" Height="240" Width="460" MinWidth="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft JhengHei UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="儲存檢測設定" FontSize="21" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}"/>
            <TextBlock Text="為這份檢測參數命名，方便之後辨識與載入。"
                       Style="{DynamicResource HudCaption}" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,19,0,0">
            <TextBlock Text="設定名稱" Foreground="{DynamicResource Muted}" Margin="0,0,0,7"/>
            <TextBox x:Name="TBNewProfileName" Height="38" Text=""
                     VerticalContentAlignment="Center" MaxLength="120"
                     AutomationProperties.Name="檢測設定名稱"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="取消" IsCancel="True" Click="Button_Click_1"
                    MinWidth="85" Margin="0,0,9,0"/>
            <Button Content="儲存" Click="Button_Click" IsDefault="True"
                    MinWidth="100" Style="{DynamicResource HudPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>

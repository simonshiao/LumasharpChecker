<Window x:Class="LumasharpChecker.view.ResultImageDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="圖片檢視"
        Height="760"
        Width="1100"
        MinHeight="520"
        MinWidth="760" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft JhengHei UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel Background="{DynamicResource Bg}">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1"
                Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding FileName}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="亮度 ROI"
                                   Foreground="#FF1565C0"
                                   FontWeight="SemiBold"
                                   Margin="0,0,18,0"/>
                        <TextBlock Text="銳利度 ROI"
                                   Foreground="#FFC62828"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding ShowSharpnessRoi, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="－"
                            Width="34"
                            Height="30"
                            Margin="0,0,6,0"
                            Click="ZoomOutButton_Click"
                            ToolTip="縮小"/>
                    <TextBlock x:Name="ZoomText"
                               Text="100%"
                               Width="58"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"/>
                    <Button Content="＋"
                            Width="34"
                            Height="30"
                            Margin="6,0,10,0"
                            Click="ZoomInButton_Click"
                            ToolTip="放大"/>
                    <Button Content="重設"
                            Height="30"
                            Padding="12,0"
                            Click="ResetZoomButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="ImageScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#FF202428"
                      PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
            <Grid x:Name="ImageContainer"
                  Width="{Binding ImagePixelWidth}"
                  Height="{Binding ImagePixelHeight}"
                  MouseLeftButtonDown="ImageContainer_MouseLeftButtonDown"
                  MouseLeftButtonUp="ImageContainer_MouseLeftButtonUp"
                  MouseMove="ImageContainer_MouseMove">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ImageScaleTransform"
                                    ScaleX="1"
                                    ScaleY="1"/>
                </Grid.LayoutTransform>
                <Image Source="{Binding Image}"
                       Width="{Binding ImagePixelWidth}"
                       Height="{Binding ImagePixelHeight}"
                       Stretch="Fill"/>
                <Canvas Width="{Binding ImagePixelWidth}"
                        Height="{Binding ImagePixelHeight}">
                    <Rectangle Canvas.Left="{Binding BrightnessX}"
                               Canvas.Top="{Binding BrightnessY}"
                               Width="{Binding BrightnessW}"
                               Height="{Binding BrightnessH}"
                               Stroke="#FF1565C0"
                               StrokeThickness="6"
                               Fill="#221565C0"/>
                    <Rectangle Canvas.Left="{Binding SharpnessX}"
                               Canvas.Top="{Binding SharpnessY}"
                               Width="{Binding SharpnessW}"
                               Height="{Binding SharpnessH}"
                               Stroke="#FFC62828"
                               StrokeThickness="6"
                               Fill="#22C62828"
                               Visibility="{Binding ShowSharpnessRoi, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Canvas>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>

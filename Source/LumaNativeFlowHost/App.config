<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- NativeR3 ships its own managed assemblies. Permit loading these trusted local package files when Windows marks the downloaded archive as Internet-zone content. -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>

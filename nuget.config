<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 大陸鏡像於此網路環境無法連線（DNS／TLS 皆不通），維持 nuget.org 即可正常還原。
         如日後需鏡像，可將可用來源加回此處。 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

<Window x:Class="LumasharpChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:LumasharpChecker.viewmodel"
        mc:Ignorable="d"
        Title="LumasharpChecker" Height="860" Width="1240"
        MinHeight="660" MinWidth="1040"
        FontFamily="Microsoft JhengHei UI"
        FontSize="13"
        Foreground="{DynamicResource Text}"
        Background="{DynamicResource Bg}">

    <Window.Resources>
        <vm:PathToImageConverter x:Key="ImageConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Shared visual tokens from ChaoMcpHub's Apple-inspired design system. -->
        <SolidColorBrush x:Key="Bg" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSubtle" Color="#F8F8FA"/>
        <SolidColorBrush x:Key="Line" Color="#D9D9DE"/>
        <SolidColorBrush x:Key="Text" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="Muted" Color="#6E6E73"/>
        <SolidColorBrush x:Key="Blue" Color="#007AFF"/>
        <SolidColorBrush x:Key="BlueSoft" Color="#E8F2FF"/>
        <SolidColorBrush x:Key="Green" Color="#34C759"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="Red" Color="#FF3B30"/>
        <DropShadowEffect x:Key="CardShadow" Color="#301D1D1F" Direction="270" ShadowDepth="3" BlurRadius="18" Opacity="0.08"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="0,0,0,13"
                                                  RecognizesAccessKey="True"
                                                  TextElement.FontSize="15"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource Text}"/>
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="Content"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputChrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF1F1F5"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFC9C9D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Blue}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource BlueSoft}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource BlueSoft}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ReadOnlyValue" TargetType="TextBlock">
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ResultValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TestActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bg}" Padding="22,10,60,8">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="Recipe 與設定" Click="OpenRecipeManager_Click" MinWidth="138" ToolTip="管理 Recipe 與逐站設定"/>
                <TextBlock Text="{Binding CurrentInspectionName, StringFormat='目前：{0}'}" Margin="18,0,0,0"
                           VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                           FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock Text="{Binding SaveSettingsMessage}" Margin="14,0,0,0" VerticalAlignment="Center"
                           MaxWidth="280" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="12"/>
            </WrapPanel>
        </Border>

        <ToggleButton Grid.RowSpan="2"
                      Panel.ZIndex="30"
                      Content="&#xE713;"
                      IsChecked="{Binding IsSettingsPanelOpen, Mode=TwoWay}"
                      Width="34"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,8,12,0"
                      FontFamily="Segoe MDL2 Assets"
                      ToolTip="設定"
                      Foreground="{StaticResource Blue}"/>

        <Border Grid.RowSpan="2"
                Panel.ZIndex="20"
                Width="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,48,12,0"
                Background="White"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14"
                Effect="{StaticResource CardShadow}"
                Visibility="{Binding IsSettingsPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TabControl FlowDirection="RightToLeft">
                <TabItem Header="檢測">
                    <StackPanel Margin="10" FlowDirection="LeftToRight">
                        <TextBlock Text="檢測項目" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding InspectionModeItems}"
                                  SelectedItem="{Binding DetectionMode, Mode=TwoWay}"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="亮度模式只判定亮度，不計算銳利度與紅色 ROI。"
                                   Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="顯示">
                    <StackPanel Margin="10" FlowDirection="LeftToRight">
                        <CheckBox Content="在 Recipe 與設定中顯示 ROI 資訊"
                                  IsChecked="{Binding ShowRoiPanel, Mode=TwoWay}"
                                  Margin="0,2,0,10"/>
                        <TextBlock Text="全部結果縮圖" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding BatchPreviewModeItems}"
                                  SelectedItem="{Binding BatchPreviewMode, Mode=TwoWay}"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="站別">
                    <StackPanel Margin="10" FlowDirection="LeftToRight">
                        <TextBlock Text="目前站數" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StationCountCombo" AutomationProperties.Name="站數"
                                  ItemsSource="{Binding StationCountOptions}"
                                  SelectedItem="{Binding StationCount, Mode=TwoWay}"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="Recipe 會保存站數與各站設定。由 10 站切回 8 站時，第 9、10 站資料會保留，之後可再切回使用。"
                                   Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="1" Margin="22,0,22,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="326"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
<GroupBox Header="亮度規格">
                        <StackPanel Margin="0">
                            <TextBlock Text="判定方式" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LimitModeItems}"
                                      SelectedItem="{Binding BrightnessLimitMode, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="基準值 / 標準差" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource ReadOnlyValue}" Margin="0,0,0,8">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F2} / σ {1:F2}">
                                        <Binding Path="BrightnessBaseValue"/>
                                        <Binding Path="CurrentProfile.BrightnessSigma"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IsBrightnessPercentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="下限偏差 %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BrightnessPercentLower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="上限偏差 %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BrightnessPercentUpper, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IsBrightnessFixedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="固定下限" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BrightnessFixedMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="固定上限" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BrightnessFixedMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource ReadOnlyValue}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="有效範圍: {0:F2} ~ {1:F2}">
                                        <Binding Path="EffectiveBrightnessMin"/>
                                        <Binding Path="EffectiveBrightnessMax"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="銳利度規格"
                              Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0">
                            <TextBlock Text="判定方式" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LimitModeItems}"
                                      SelectedItem="{Binding SharpnessLimitMode, Mode=TwoWay}"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="基準值 / 標準差" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource ReadOnlyValue}" Margin="0,0,0,8">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F2} / σ {1:F2}">
                                        <Binding Path="SharpnessBaseValue"/>
                                        <Binding Path="CurrentProfile.SharpnessSigma"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <StackPanel Visibility="{Binding IsSharpnessPercentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="下限偏差 %" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SharpnessPercentLower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                         Margin="0,0,0,8"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsSharpnessFixedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="固定下限" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SharpnessFixedMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                         Margin="0,0,0,8"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EffectiveSharpnessMin, StringFormat='有效下限: {0:F2}'}"
                                       Style="{StaticResource ReadOnlyValue}"/>
                        </StackPanel>
                    </GroupBox>

                    <Button Command="{Binding SaveInspectionSettingsCommand}"
                            Content="儲存檢測設定"
                            Margin="0,0,0,8"/>


                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8"
                        Effect="{StaticResource CardShadow}">
                    <Viewbox Stretch="Uniform">
                        <Grid>
                            <Image Source="{Binding DisplayImage}" Stretch="None" IsHitTestVisible="False"/>
                            <Canvas x:Name="MainRoiCanvas"
                                    Width="{Binding DisplayImage.PixelWidth}"
                                    Height="{Binding DisplayImage.PixelHeight}"
                                    Background="Transparent"
                                    MouseLeftButtonDown="MainRoiCanvas_MouseLeftButtonDown"
                                    MouseMove="MainRoiCanvas_MouseMove"
                                    MouseLeftButtonUp="MainRoiCanvas_MouseLeftButtonUp">
                                    <Rectangle Stroke="#FF43A047"
                                               StrokeThickness="{Binding StrokeThickness}"
                                               Width="{Binding RectWidth}"
                                               Height="{Binding RectHeight}"
                                               Canvas.Left="{Binding RectX}"
                                               Canvas.Top="{Binding RectY}"
                                               IsHitTestVisible="False"/>
                                    <Rectangle Stroke="#FF039BE5"
                                               StrokeThickness="{Binding StrokeThickness2}"
                                               Width="{Binding RectWidth2}"
                                               Height="{Binding RectHeight2}"
                                               Canvas.Left="{Binding RectX2}"
                                               Canvas.Top="{Binding RectY2}"
                                               IsHitTestVisible="False"/>
                                    <Rectangle Stroke="#FFE53935"
                                               Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               StrokeThickness="{Binding StrokeThickness3}"
                                               Width="{Binding RectWidth3}"
                                               Height="{Binding RectHeight3}"
                                               Canvas.Left="{Binding RectX3}"
                                               Canvas.Top="{Binding RectY3}"
                                               IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="14">
                    <StackPanel>
                        <DockPanel Margin="2,0,2,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox Width="110" Margin="0,0,8,0"
                                          ItemsSource="{Binding RoiTypeItems}"
                                          SelectedItem="{Binding SelectedRoiType, Mode=TwoWay}"
                                          Visibility="{Binding IsRoiEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Command="{Binding ToggleRoiEditingCommand}"
                                        IsEnabled="{Binding CanEditRoi}"
                                        Padding="12,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="調整 ROI"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRoiEditing}" Value="True">
                                                    <Setter Property="Content" Value="完成 ROI"/>
                                                    <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="站別" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StationStatusMessage}" Foreground="{StaticResource Muted}"
                                       FontSize="11" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding StationSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0">
                                        <Button Content="{Binding Number}" Padding="0" MinWidth="0" MinHeight="36"
                                                Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Number}"
                                                IsEnabled="{Binding DataContext.IsRecipeActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="切換站別">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BlueSoft}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousTestImageCommand}"
                                Content="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="42" Height="36" MinHeight="0" Padding="0" Margin="2"
                                IsEnabled="{Binding CanNavigatePrevious}" ToolTip="上一張圖片"/>
                        <Button x:Name="TestImageCountButton"
                                Click="OpenTestImagePicker_Click"
                                Padding="12,6" Margin="4,2"
                                ToolTip="選擇圖片；目前只切換預覽，不會執行檢測">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TestImageInfo}" FontWeight="SemiBold"/>
                                <TextBlock Text=" &#xE70D;" FontFamily="Segoe MDL2 Assets" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NextTestImageCommand}"
                                Content="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Width="42" Height="36" MinHeight="0" Padding="0" Margin="2"
                                IsEnabled="{Binding CanNavigateNext}" ToolTip="下一張圖片"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>




                    <GroupBox Header="測試圖片">
                        <StackPanel Margin="0">
                            <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                                <Button Style="{StaticResource TestActionButton}"
                                        Command="{Binding TestImageCommand}"
                                        ToolTip="只載入資料夾清單與預覽，不執行測試"
                                        AutomationProperties.Name="選擇資料夾">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" Margin="0,0,6,0">
                                            <Path Data="M2,5 L9,5 L11,8 L22,8 L22,19 L2,19 Z"
                                                  Fill="#E8F2FF" Stroke="#007AFF" StrokeThickness="1.5"/>
                                        </Viewbox>
                                        <TextBlock Text="選擇資料夾" FontFamily="Microsoft JhengHei UI" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TestActionButton}"
                                        Command="{Binding StartContinuousTestCommand}"
                                        ToolTip="開始連續測試清單中的所有圖片"
                                        AutomationProperties.Name="連續測試">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" Margin="0,0,6,0">
                                            <Grid Width="24" Height="24">
                                                <Ellipse Stroke="#34C759" StrokeThickness="2.5"/>
                                                <Path Data="M9,6 L18,12 L9,18 Z" Fill="#34C759"/>
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Text="連續測試" FontFamily="Microsoft JhengHei UI" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TestActionButton}"
                                        Command="{Binding TestSingleImageCommand}"
                                        ToolTip="選擇並測試單張圖片"
                                        AutomationProperties.Name="單張測試">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" Margin="0,0,6,0">
                                            <Grid Width="24" Height="20">
                                                <Border BorderBrush="#007AFF" BorderThickness="1.7" CornerRadius="2"/>
                                                <Ellipse Width="3.5" Height="3.5" Fill="#007AFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,3,0,0"/>
                                                <Path Data="M3,17 L9,10 L13,14 L17,8 L22,17 Z" Fill="#B9D8FF" Stroke="#007AFF" StrokeThickness="1.2"/>
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Text="單張測試" FontFamily="Microsoft JhengHei UI" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TestActionButton}"
                                        Command="{Binding ExportTestImagesCommand}"
                                        ToolTip="匯出 Excel 檢測報表"
                                        AutomationProperties.Name="匯出 Excel 報表">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" Margin="0,0,6,0">
                                            <Grid Width="20" Height="22">
                                                <Path Data="M3,1 L13,1 L18,6 L18,21 L3,21 Z M13,1 L13,6 L18,6"
                                                      Fill="#F8F8FA" Stroke="#6E6E73" StrokeThickness="1.4"/>
                                                <Path Data="M10,7 L10,15 M7,12 L10,15 L13,12"
                                                      Stroke="#007AFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Text="匯出報表" FontFamily="Microsoft JhengHei UI" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TestActionButton}"
                                        Command="{Binding ShowTestImageResultsCommand}"
                                        ToolTip="檢視全部檢測結果"
                                        AutomationProperties.Name="檢視全部結果">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Viewbox Width="20" Height="20" Margin="0,0,6,0">
                                            <StackPanel Width="22" VerticalAlignment="Center">
                                                <Border Height="2" Background="#007AFF" Margin="0,2"/>
                                                <Border Height="2" Background="#6E6E73" Margin="0,2"/>
                                                <Border Height="2" Background="#6E6E73" Margin="0,2"/>
                                            </StackPanel>
                                        </Viewbox>
                                        <TextBlock Text="檢視結果" FontFamily="Microsoft JhengHei UI" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <Border Background="{StaticResource SurfaceSubtle}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsAnalyzingTestImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AnalysisProgressText}"
                                               Style="{StaticResource ResultValue}"
                                               TextWrapping="Wrap"/>
                                    <ProgressBar Minimum="0"
                                                 Maximum="{Binding AnalysisProgressMaximum}"
                                                 Value="{Binding AnalysisProgressValue}"
                                                 Height="8"
                                                 Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource SurfaceSubtle}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="總結果" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource ResultValue}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="總判定 OK / NG: {0} / {1}">
                                                <Binding Path="OverallOkCount"/>
                                                <Binding Path="OverallNgCount"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Separator Margin="0,8"/>
                            <TextBlock Style="{StaticResource ResultValue}">
                                <Run Text="亮度: "/>
                                <Run Text="{Binding TestImageBrightness, StringFormat={}{0:F2}}" Foreground="{Binding BrightnessColor}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding TestImageBrightnessDeltaPercentText, Mode=OneWay}" Foreground="{Binding BrightnessColor}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource ResultValue}"
                                       Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="銳利度: "/>
                                <Run Text="{Binding TestImageSharpness, StringFormat={}{0:F2}}" Foreground="{Binding SharpnessColor}"/>
                            </TextBlock>
                            <TextBlock Text="亮度檢測 ROI（藍色）" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                            <TextBlock Style="{StaticResource ResultValue}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="X: {0:F0} Y: {1:F0} W: {2:F0} H: {3:F0}">
                                        <Binding Path="TestImageBrightnessROI.X"/>
                                        <Binding Path="TestImageBrightnessROI.Y"/>
                                        <Binding Path="TestImageBrightnessROI.Width"/>
                                        <Binding Path="TestImageBrightnessROI.Height"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="銳利度檢測 ROI（紅色）"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,8,0,3"
                                       Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Style="{StaticResource ResultValue}"
                                       Visibility="{Binding IsSharpnessEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="X: {0:F0} Y: {1:F0} W: {2:F0} H: {3:F0}">
                                        <Binding Path="TestImageSharpnessROI.X"/>
                                        <Binding Path="TestImageSharpnessROI.Y"/>
                                        <Binding Path="TestImageSharpnessROI.Width"/>
                                        <Binding Path="TestImageSharpnessROI.Height"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding TestImageMatchFailed}"
                                       Foreground="Red"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

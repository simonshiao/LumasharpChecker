<Window x:Class="LumasharpChecker.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="各站圖庫設定" Width="950" Height="700" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft JhengHei UI" FontSize="13"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="各站圖庫設定" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="選取一次資料夾，即可設定目前 Recipe 的各站圖庫路徑。" Foreground="{StaticResource Muted}" Margin="0,5,0,8"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<GroupBox Header="快速設定各站 OK／NG 圖庫" Margin="0,12,0,12"
                          IsEnabled="{Binding IsRecipeActive}">
                    <StackPanel>
                        <TextBlock Text="可選日期、站號或 OK／NG 資料夾，例如 welding\08\17\2；程式會辨識日期層並帶入各站路徑，不會建立或修改來源資料夾。"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="選擇圖庫資料夾…"
                                    Command="{Binding SelectDatabaseDayFolderCommand}"
                                    Background="{StaticResource Blue}" Foreground="White"
                                    BorderBrush="{StaticResource Blue}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding DatabaseDayFolderDisplay, Mode=OneWay}"
                                     IsReadOnly="True" ToolTip="{Binding DatabaseDayFolderDisplay}"
                                     VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="OK 路徑" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="NG 路徑" FontWeight="SemiBold"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding StationDatabasePaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number, StringFormat='站 {0}'}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding OkPath}" ToolTip="{Binding OkPath}"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
                                            <TextBlock Text="{Binding OkStatus, StringFormat='資料夾：{0}'}"
                                                       Foreground="{StaticResource Muted}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding NgPath}" ToolTip="{Binding NgPath}"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}"/>
                                            <TextBlock Text="{Binding NgStatus, StringFormat='資料夾：{0}'}"
                                                       Foreground="{StaticResource Muted}" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="狀態依目錄是否存在顯示；站號目錄內未分類的圖片，可從主畫面「本站圖片」載入。缺少的目錄不會自動建立。"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
        </ScrollViewer>
        <Button Grid.Row="2" HorizontalAlignment="Right" Content="完成" MinWidth="100" Margin="0,12,0,0" Click="Done_Click"/>
    </Grid>
</Window>

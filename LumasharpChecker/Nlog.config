<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
	  keepFileOpen = "true"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">

	<targets async="true">


	<target name="console" xsi:type="Console" />
	<target xsi:type="File" name="mainf" fileName="${basedir}/logs/${shortdate}_Main.txt"
			layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}|${uppercase:${level}}|${callsite}|${message}" encoding="utf-8"
			archiveDateFormat="yyyyMMdd"
			archiveFileName="${basedir}/logs/archives/{#}_Main.zip"
			archiveNumbering="DateAndSequence"
			archiveAboveSize="100000000"
			enableArchiveFileCompression="true"/>
	<target xsi:type="File" name="plcf" fileName="${basedir}/logs/${shortdate}_PLC.txt"
			layout="${longdate}|${uppercase:${level}}|${callsite}|${message}" encoding="utf-8"
			archiveDateFormat="yyyyMMdd"
			archiveFileName="${basedir}/logs/archives/{#}_SMA.zip"
			archiveNumbering="DateAndSequence"
			archiveAboveSize="100000000"
			enableArchiveFileCompression="true"/>
	<target xsi:type="File" name="aoif" fileName="${basedir}/logs/${shortdate}_AOI.txt"
			layout="${longdate}|${uppercase:${level}}|${callsite}|${message}" encoding="utf-8"
			archiveDateFormat="yyyyMMdd"
			archiveFileName="${basedir}/logs/archives/{#}_AOI.zip"
			archiveNumbering="DateAndSequence"
			archiveAboveSize="100000000"
			enableArchiveFileCompression="true"/>
	<target xsi:type="File" name="bsmonitor" fileName="${basedir}/logs/${shortdate}_monitor.csv"
			encoding="utf-8"
			archiveDateFormat="yyyyMMdd"
			archiveFileName="${basedir}/logs/archives/{#}_monitor.zip"
			archiveNumbering="DateAndSequence"
			archiveAboveSize="100000000"
			enableArchiveFileCompression="true">
			<layout xsi:type="CsvLayout"
              delimiter="," 
              withHeader="true">
				<column name="time" layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}" />
				<column name="message" layout="${message}" />
			  </layout>
			</target>
	</targets>

  <rules>
    <logger name="main" minlevel="Trace" writeTo="mainf, console" />
	<logger name="plc" minlevel="Trace" writeTo="plcf, console" />
	<logger name="aoi" minlevel="Trace" writeTo="aoif, console" />
	<logger name="monitor" minlevel="Trace" writeTo="bsmonitor, console" />
  </rules>
</nlog>
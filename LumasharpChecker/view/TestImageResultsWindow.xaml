<Window x:Class="LumasharpChecker.view.TestImageResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LumasharpChecker.view"
        Title="測試圖片結果"
        Height="600"
        Width="1080"
        MinHeight="460"
        MinWidth="860">
    <Window.Resources>
        <local:DeferredThumbnailConverter x:Key="DeferredThumbnailConverter"/>
        <local:ResultStatusBrushConverter x:Key="ResultStatusBrushConverter"/>
        <Style x:Key="ResultStatusCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource ResultStatusBrushConverter}}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Background="#FFF2F2F2" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="測試圖片結果"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#FF263238"
                   Margin="0,0,0,10"/>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="78"
                  RowHeaderWidth="0"
                  FontSize="14"
                  Background="White"
                  BorderBrush="#FFCFD8DC"
                  BorderThickness="1"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="縮圖" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="78"
                                    Height="62"
                                    Background="#FFECEFF1"
                                    BorderBrush="#FFCFD8DC"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource DeferredThumbnailConverter}}"
                                       Stretch="Uniform"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="檔名" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="亮度" Binding="{Binding Brightness, StringFormat={}{0:F2}}" Width="*"/>
                <DataGridTextColumn Header="亮度差異(%)" Binding="{Binding BrightnessDeltaPercentText}" Width="*"/>
                <DataGridTextColumn Header="銳利度" Binding="{Binding SharpnessText}" Width="*"/>
                <DataGridTextColumn Header="亮度判定" Binding="{Binding BrightnessResult}" Width="*" ElementStyle="{StaticResource ResultStatusCellStyle}"/>
                <DataGridTextColumn Header="銳利度判定" Binding="{Binding SharpnessResult}" Width="*" ElementStyle="{StaticResource ResultStatusCellStyle}"/>
                <DataGridTextColumn Header="總判定" Binding="{Binding OverallResult}" Width="*" ElementStyle="{StaticResource ResultStatusCellStyle}"/>
                <DataGridTextColumn Header="匹配" Binding="{Binding MatchResult}" Width="*" ElementStyle="{StaticResource ResultStatusCellStyle}"/>
                <DataGridTextColumn Header="ROI" Binding="{Binding RoiDisplay}" Width="1.6*"/>
                <DataGridTextColumn Header="備註" Binding="{Binding Message}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
